    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400..700&family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="engagement/style.css" />
    <link rel="stylesheet" href="CF.Events.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        window.initializeTooltips = () => {
            setTimeout(() => {
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                    var instance = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
                    if (!instance) {
                        new bootstrap.Tooltip(tooltipTriggerEl);
                    }
                });
            }, 100);
        };

        window.copyToClipboardFromEvent = (text) => {
            const element = event.currentTarget;
            window.copyToClipboard(text, element);
        };

        window.copyToClipboard = (text, element) => {
            navigator.clipboard.writeText(text).then(() => {
                if (element) {
                    const codeElement = element.querySelector('code');
                    const originalText = codeElement ? codeElement.innerText : null;

                    if (codeElement) {
                        codeElement.innerText = 'copied to clipboard';
                        codeElement.classList.add('small', 'text-muted');
                        codeElement.classList.remove('fs-4');
                    }

                    element.classList.add('clicked');

                    setTimeout(() => {
                        element.classList.remove('clicked');
                        if (codeElement && originalText) {
                            codeElement.innerText = originalText;
                            codeElement.classList.remove('small', 'text-muted');
                            codeElement.classList.add('fs-4');
                        }
                    }, 1500);
                }
                console.log('Copied to clipboard:', text);
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
