@implements IDisposable
@inject ToastService ToastService

<div class="toast-container">
    @foreach (var toast in ToastService.GetToasts())
    {
        <div class="toast @toast.Type.ToString().ToLower()" @key="toast.Id">
            <div class="toast-message">@toast.Message</div>
            <button class="toast-close" @onclick="() => ToastService.Remove(toast.Id)">&times;</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
    }
}
