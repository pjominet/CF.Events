@page "/admin/events"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = Roles.Admin)]

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active">Events</li>
                    </ol>
                </nav>
                <h1 class="cursive fs-1">Manage Events</h1>
            </div>
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-calendar-plus me-2"></i>New Event
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Name</th>
                                <th>Date</th>
                                <th class="text-center">Design</th>
                                <th class="text-center">Active</th>
                                <th>Quick Invite</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@allEvents" Context="ev">
                                <tr>
                                    <td class="fw-bold">@ev.Name <br/><small class="text-muted fw-normal">@ev.Type</small></td>
                                    <td>@ev.Date.ToShortDateString()</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(ev.InvitationFileName))
                                        {
                                            <span class="badge bg-primary">
                                                @ev.InvitationFileName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">None</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input" type="checkbox" checked="@ev.IsActive" @onchange="() => ToggleEventStatus(ev)">
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm" style="max-width: 250px;">
                                            <input type="email" class="form-control" placeholder="guest@email.com"
                                                   @oninput="(e) => { inviteEmail = e.Value?.ToString() ?? string.Empty; selectedEventId = ev.Id; }">
                                            <button class="btn btn-primary" type="button" @onclick="HandleInviteToEvent">
                                                <i class="bi bi-person-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a href="/events/@ev.Id/invitation" class="btn btn-outline-info btn-sm" title="Preview Invitation" target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
                @if (allEvents.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        No events found. Create your first event.
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Event</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="newEvent" OnValidSubmit="HandleCreateEvent" FormName="createEventForm">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label fw-bold">Event Name</label>
                            <InputText class="form-control" @bind-Value="newEvent.Name" placeholder="Wedding" />
                            <ValidationMessage For="@(() => newEvent.Name)" class="text-danger" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Type</label>
                                <InputSelect class="form-select" @bind-Value="newEvent.Type">
                                    <option value="Wedding">Wedding</option>
                                    <option value="Engagement">Engagement</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Date</label>
                                <InputDate class="form-control" @bind-Value="newEvent.Date" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Location</label>
                            <InputText class="form-control" @bind-Value="newEvent.Location" placeholder="Grand Hall" />
                            <ValidationMessage For="@(() => newEvent.Location)" class="text-danger" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Invitation Design</label>
                            <InputSelect class="form-select" @bind-Value="newEvent.InvitationFileName">
                                <option value="">-- No custom design --</option>
                                @foreach (var file in invitationFiles)
                                {
                                    <option value="@file">@file</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                            <button type="submit" class="btn btn-success" disabled="@isCreatingEvent">
                                @if (isCreatingEvent)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Create Event
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
