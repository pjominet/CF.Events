@page "/engagement/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="admin-page centered-container">
    <div class="admin-container">
        <h1>Admin Dashboard</h1>

        @if (isLoading)
        {
            <div class="loading-container">
                <p>Loading...</p>
                <div class="loading-spinner"></div>
            </div>
        }
        else if (isApiOffline)
        {
            <div class="error-container text-center">
                <p class="error">@apiError</p>
                <button class="refresh-btn mt-20" @onclick="() => { isApiOffline = false; isLoading = true; StateHasChanged(); }">Retry</button>
            </div>
        }
        else if (showSetup)
        {
            <div id="setupSection" class="login-container">
                <h2>Initial Admin Setup</h2>
                <p>Please set a password for the admin account.</p>
                <form @onsubmit="HandleSetup">
                    <input type="password" @bind="setupPassword" placeholder="Set Password" required>
                    <input type="password" @bind="confirmPassword" placeholder="Confirm Password" required>
                    <button type="submit">Set Password</button>
                </form>
                @if (!string.IsNullOrEmpty(setupError))
                {
                    <p class="error">@setupError</p>
                }
            </div>
        }
        else if (showLogin)
        {
            <div id="loginSection" class="login-container">
                <h2>Login</h2>
                <form @onsubmit="HandleLogin">
                    <input type="password" @bind="loginPassword" placeholder="Enter Password" required>
                    <button type="submit">Login</button>
                </form>
                @if (!string.IsNullOrEmpty(loginError))
                {
                    <p class="error">@loginError</p>
                }
            </div>
        }
        else
        {
            <div id="rsvpList">
                <div class="admin-controls">
                    <div class="stats">
                        <div class="stat-item">
                            <span class="stat-label">Total Attendance:</span>
                            <span class="stat-value">@totalAttendance</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Dinner Guests:</span>
                            <span class="stat-value">@totalDinner</span>
                        </div>
                    </div>
                    <button class="refresh-btn" @onclick="LoadRsvps">Refresh Data</button>
                    <button class="refresh-btn btn-logout ml-10" @onclick="Logout">Logout</button>
                </div>

                <div class="rsvp-table-container">
                    <table class="rsvp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Attending</th>
                                <th>Plus One</th>
                                <th>Dinner</th>
                                <th>Comments</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rsvp in rsvps)
                            {
                                <tr>
                                    <td>@rsvp.Name</td>
                                    <td>@(rsvp.Attending ? "✅ Yes" : "❌ No")</td>
                                    <td>@(rsvp.Attending && rsvp.BringsPlusOne ? "👥 +1" : "-")</td>
                                    <td>@(rsvp.Attending && rsvp.JoinForDinner ? "🍴 Yes" : "-")</td>
                                    <td class="comment-cell">@rsvp.Comments</td>
                                    <td>@rsvp.SubmittedAt.ToLocalTime().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (rsvps.Count == 0)
                    {
                        <p>No RSVPs received yet.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>
