@page "/engagement/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = Constants.Roles.Admin)]

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded-lg-custom admin-card-width admin-max-width-dashboard">
        <h1 class="text-center mb-4">Admin Dashboard</h1>

        @if (isLoading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <p>Loading...</p>
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (isApiOffline)
        {
            <div class="text-center py-4">
                <p class="text-danger">@apiError</p>
                <button class="btn btn-primary" @onclick="() => { isApiOffline = false; isLoading = true; StateHasChanged(); }">Retry</button>
            </div>
        }
        else
        {
            <div id="rsvpList">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div class="d-flex gap-3">
                        <div class="bg-white-custom p-2 px-3 rounded shadow-sm">
                            <span class="fw-bold text-primary">Total Attendance:</span>
                            <span class="fw-bold ms-2 text-secondary">@totalAttendance</span>
                        </div>
                        <div class="bg-white-custom p-2 px-3 rounded shadow-sm">
                            <span class="fw-bold text-primary">Dinner Guests:</span>
                            <span class="fw-bold ms-2 text-secondary">@totalDinner</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="LoadRsvps" disabled="@isRefreshing">
                            @if (isRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Refreshing...</span>
                            }
                            else
                            {
                                <span>Refresh Data</span>
                            }
                        </button>
                        <button class="btn btn-danger" @onclick="Logout">Logout</button>
                    </div>
                </div>

                <div class="table-scroll-container">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Attending</th>
                                <th>Plus One</th>
                                <th>Dinner</th>
                                <th>Comments</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="rsvps" Context="rsvp">
                                <tr @key="rsvp.Id">
                                    <td>@rsvp.Name</td>
                                    <td>
                                        <div @ref="copyBadgeRefs[rsvp.Id]"
                                             @onclick="() => CopyCode(rsvp.AccessCode, rsvp.Id)"
                                             class="copy-badge" style="width: 170px">
                                            <code class="text-primary fw-bold">@rsvp.AccessCode</code>
                                            <i class="bi bi-copy text-muted small"></i>
                                        </div>
                                    </td>
                                    <td>@(rsvp.Attending ? "✅ Yes" : "❌ No")</td>
                                    <td>@(rsvp is { Attending: true, BringsPlusOne: true } ? "👥 +1" : "-")</td>
                                    <td>@(rsvp is { Attending: true, JoinForDinner: true } ? "🍴 Yes" : "-")</td>
                                    <td class="text-muted small italic comments-cell">
                                        @if (!string.IsNullOrEmpty(rsvp.Comments))
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 150px;">@rsvp.Comments</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>@rsvp.SubmittedAt.ToLocalTime().ToShortDateString()</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-info"
                                                    @onclick="() => ShowDetails(rsvp)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger"
                                                    @onclick="() => RequestDelete(rsvp.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                    @if (rsvps.Count is 0)
                    {
                        <p class="text-center text-muted py-4">No RSVPs received yet.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

<ConfirmationDialog @ref="deleteConfirmation"
                    Title="Delete RSVP"
                    Message="Are you sure you want to delete this RSVP? This action cannot be undone."
                    ConfirmText="Delete"
                    OnConfirmation="HandleDeleteConfirmation" />

<RsvpDetailModal @ref="detailModal" Rsvp="selectedRsvp" />
