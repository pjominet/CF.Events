@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = Roles.Admin)]

<div class="container-fluid min-vh-100 p-3">
    <div class="card border-0 p-4 shadow-sm">
        <h1 class="text-center mb-4">Admin Dashboard</h1>

        <div class="row g-4">
            <!-- User Management -->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Invite New User</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="registerRequest" OnValidSubmit="HandleInviteUser">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Email Address</label>
                                <InputText class="form-control" @bind-Value="registerRequest.Email" placeholder="guest@example.com" />
                                <ValidationMessage For="@(() => registerRequest.Email)" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Temporary Password</label>
                                <div class="input-group">
                                    <InputText class="form-control" @bind-Value="registerRequest.Password" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="GeneratePassword">Generate</button>
                                </div>
                                <ValidationMessage For="@(() => registerRequest.Password)" class="text-danger" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100" disabled="@isInviting">
                                @if (isInviting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Send Invitation
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- Event Management -->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Create New Event</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="newEvent" OnValidSubmit="HandleCreateEvent">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label class="form-label">Event Name</label>
                                <InputText class="form-control" @bind-Value="newEvent.Name" placeholder="Wedding" />
                                <ValidationMessage For="@(() => newEvent.Name)" class="text-danger" />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Type</label>
                                    <InputSelect class="form-select" @bind-Value="newEvent.Type">
                                        <option value="Wedding">Wedding</option>
                                        <option value="Engagement">Engagement</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Date</label>
                                    <InputDate class="form-control" @bind-Value="newEvent.Date" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success w-100" disabled="@isCreatingEvent">
                                @if (isCreatingEvent)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Create Event
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Global RSVPs</h3>
                <button class="btn btn-outline-secondary" @onclick="Logout">Logout</button>
            </div>
            <p class="text-muted">RSVP management and detailed guest list will be displayed here.</p>
        </div>
    </div>
</div>
