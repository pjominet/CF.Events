@page "/Error"
@using System.Diagnostics
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="admin-container centered-container">
    <h2 class="cursive title-cursive">Oops!</h2>
    <div class="text-center">
        <p class="error-message">Something went wrong while processing your request.</p>
        <p>Please try again later or return to the home page.</p>

        @if (ShowRequestId)
        {
            <p class="request-id">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </p>
        }

        <div class="mt-20">
            <a href="engagement" class="btn-primary">Go to Home</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId => Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
}
