@page "/events/{eventId:int}/invitation"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (eventData is null)
{
    <div class="container py-5">
        <div class="alert alert-danger">Event not found or you are not invited.</div>
        <a href="/" class="btn btn-secondary">Back to Dashboard</a>
    </div>
}
else
{
    <div class="invitation-wrapper">
        @if (string.IsNullOrEmpty(eventData.InvitationFileName))
        {
            <div class="container py-5 text-center">
                <h1>@eventData.Name</h1>
                <p>@eventData.Type - @eventData.Date.ToLongDateString()</p>
                <p>@eventData.Location</p>
                <p>@eventData.Description</p>
                <a href="events/@eventData.Id/rsvp" class="btn btn-primary btn-lg mt-4">RSVP NOW</a>
            </div>
        }
        else
        {
            <div id="invitation-container">
                @((MarkupString)processedHtml)
            </div>
        }
    </div>
}

<style>
    .invitation-wrapper {
        min-height: 100vh;
        width: 100%;
    }
</style>
