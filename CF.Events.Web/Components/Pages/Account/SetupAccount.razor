@page "/account/setup"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="container d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="card p-4 shadow-sm" style="max-width: 400px; width: 100%;">
        <h2 class="text-center mb-4">Complete Account Setup</h2>
        <p class="text-muted text-center mb-4">On your first login, please set your display name and a new password.</p>

        <EditForm Model="setupRequest" OnValidSubmit="HandleSetup" FormName="setupForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <InputText class="form-control" @bind-Value="setupRequest.DisplayName" placeholder="e.g. John Doe" />
                <ValidationMessage For="@(() => setupRequest.DisplayName)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Current Password</label>
                <InputText type="password" class="form-control" @bind-Value="setupRequest.CurrentPassword" />
                <ValidationMessage For="@(() => setupRequest.CurrentPassword)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <InputText type="password" class="form-control" @bind-Value="setupRequest.NewPassword" />
                <ValidationMessage For="@(() => setupRequest.NewPassword)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm New Password</label>
                <InputText type="password" class="form-control" @bind-Value="setupRequest.ConfirmNewPassword" />
                <ValidationMessage For="@(() => setupRequest.ConfirmNewPassword)" class="text-danger" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3">@errorMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                Complete Setup
            </button>
        </EditForm>
    </div>
</div>
