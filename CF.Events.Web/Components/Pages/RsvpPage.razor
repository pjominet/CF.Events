@page "/engagement/rsvp"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded-lg-custom">
        <h2 class="cursive text-center mb-4">RSVP</h2>

        @if (isLoading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <p>Checking RSVP status...</p>
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (isApiOffline)
        {
            <div class="text-center py-4">
                <p class="text-danger">@apiError</p>
                <button class="btn btn-primary mt-3" @onclick="() => { isApiOffline = false; isLoading = true; StateHasChanged(); }">Retry</button>
                <a href="engagement" class="btn btn-secondary mt-2 ms-2">Back</a>
            </div>
        }
        else if (showResult)
        {
            <div id="rsvpResult" class="text-center">
                <div id="resultMessage" class="d-flex flex-column align-items-center">
                    <h3 class="cursive mb-3">Current Status</h3>
                    <p class="fs-5 mb-1"><strong>@(currentRsvp?.Attending is true ? "Happily Accepted" : "Regretfully Declined")</strong></p>
                    @if (currentRsvp is not null)
                    {
                        <div @ref="copyBadgeElement"
                             class="mt-3 p-3 rounded bg-white-custom shadow-sm d-flex flex-column align-items-center copy-badge"
                             style="width: auto; min-width: 250px;"
                             @onclick="() => CopyCode(currentRsvp.AccessCode)">
                            <small class="text-uppercase fw-bold text-primary d-block" style="font-size: 0.7rem;">Your Access Code</small>
                            <code class="fs-4 fw-bold letter-spacing-1 text-primary">@currentRsvp.AccessCode <i class="bi bi-copy text-muted mt-2 small"></i></code>
                            <p class="small text-muted mb-0 mt-2" style="font-size: 0.75rem;">Use this code to access your RSVP from any device.</p>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <button @onclick="ModifyRsvp" class="btn btn-primary px-4">Modify</button>
                    <button @onclick="() => deleteConfirmation.Show()" class="btn btn-danger px-4">Delete</button>
                </div>
            </div>
        }
        else
        {
            <div id="rsvpFormContainer">
                <p class="text-center mb-4">Will you be joining us?</p>
                <EditForm Model="rsvpModel" OnValidSubmit="HandleSubmit" id="rsvpForm" class="d-flex flex-column gap-3" FormName="RsvpForm">
                    <InputHidden @bind-Value="rsvpModel.AccessCode"></InputHidden>
                    <DataAnnotationsValidator/>
                    <div class="mb-1">
                        <InputText @bind-Value="rsvpModel.Name" class="form-control" maxlength="100" placeholder="Your Name"/>
                        <ValidationMessage For="@(() => rsvpModel.Name)" class="text-danger small mt-1"/>
                    </div>

                    <div class="d-flex justify-content-center gap-4 my-2">
                        <InputRadioGroup @bind-Value="rsvpModel.Attending">
                            <div class="form-check">
                                <InputRadio Value="true" class="form-check-input" id="accept"/>
                                <label class="form-check-label" for="accept">Happily Accept</label>
                            </div>
                            <div class="form-check">
                                <InputRadio Value="false" class="form-check-input" id="decline"/>
                                <label class="form-check-label" for="decline">Regretfully Decline</label>
                            </div>
                        </InputRadioGroup>
                    </div>

                    @if (rsvpModel.Attending)
                    {
                        <div id="additionalOptions" class="d-flex flex-column gap-3 mt-2">
                            <div class="row g-3 justify-content-center">
                                <div class="col-auto">
                                    <div class="form-check">
                                        <InputCheckbox @bind-Value="rsvpModel.BringsPlusOne" class="form-check-input" id="plusOne"/>
                                        <label class="form-check-label" for="plusOne">Bringing a +1?</label>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <div class="form-check">
                                        <InputCheckbox @bind-Value="rsvpModel.JoinForDinner" class="form-check-input" id="dinner"/>
                                        <label class="form-check-label" for="dinner">Join us for dinner?</label>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <InputTextArea @bind-Value="rsvpModel.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"/>
                            </div>
                        </div>
                    }

                    <p id="privacy-hint" class="d-flex justify-content-center my-2 text-muted">
                        Information will be stored confidentially and is only visible to the event organizers.
                        <br/>
                        After the event is over, any stored information will be deleted.
                    </p>

                    <div class="d-flex justify-content-center gap-2">
                        <button id="submitBtn" class="btn btn-primary flex-grow-1" type="submit">@(rsvpModel.Id > 0 ? "Update RSVP" : "Send")</button>
                        <a href="engagement" class="btn btn-secondary flex-grow-1 d-flex align-items-center justify-content-center">Back</a>
                    </div>
                </EditForm>

                @if (rsvpModel.Id is 0)
                {
                    <hr class="my-4">
                    <div class="text-center">
                        <p class="small text-muted mb-2">Already RSVP'd on another device?</p>
                        <div class="input-group input-group-sm mx-auto" style="max-width: 250px;">
                            <input type="text" class="form-control text-center text-uppercase fw-bold"
                                   placeholder="Enter Code"
                                   @bind="accessCodeInput"
                                   maxlength="6"
                                   disabled="@isRetrieving"/>
                            <button class="btn btn-info" type="button" @onclick="RetrieveByCode" disabled="@isRetrieving">
                                @if (isRetrieving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-search"></i>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<ConfirmationDialog @ref="deleteConfirmation"
                    Title="Delete RSVP"
                    Message="Are you sure you want to delete your RSVP? This cannot be undone."
                    ConfirmText="Delete"
                    OnConfirmation="HandleDeleteConfirmation"/>
