@page "/invites"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="cursive fs-1">My Invitations</h1>
            <p class="text-muted">Here are all the events you have been invited to.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (myInvites.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-3">
            <i class="bi bi-envelope-open text-muted display-1 mb-3"></i>
            <h3>No invitations found</h3>
            <p class="text-muted">You haven't been invited to any events yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var invite in myInvites)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@invite.Event.Name</h5>
                                <span class="badge bg-light text-primary">@invite.Event.Type</span>
                            </div>
                            <p class="card-text small text-muted mb-3">
                                <i class="bi bi-calendar-event me-2"></i>@invite.Event.Date.ToString("MMM dd, yyyy")<br />
                                <i class="bi bi-geo-alt me-2"></i>@invite.Event.Location
                            </p>
                            <hr class="text-muted opacity-25" />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="small fw-bold">Status:</span>
                                @if (invite.Rsvp.SubmittedAt > DateTime.MinValue.AddDays(1))
                                {
                                    <span class="badge bg-success">RSVP'd</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                <a href="events/@invite.Event.Id/invitation" class="btn btn-primary">
                                    <i class="bi bi-eye me-2"></i>View Invitation
                                </a>
                                <a href="events/@invite.Event.Id/rsvp" class="btn btn-outline-secondary">
                                    <i class="bi bi-pencil-square me-2"></i>
                                    @(invite.Rsvp.SubmittedAt > DateTime.MinValue.AddDays(1) ? "Edit RSVP" : "RSVP Now")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
