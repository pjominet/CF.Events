<div class="modal fade @(show ? "show" : "") modal-backdrop-custom" id="confirmationModal" tabindex="-1" style="display: @(show ? "block" : "none");" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow modal-content-custom">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fs-2">@Title</h5>
                <button type="button" class="btn-close" @onclick="Cancel" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="fs-5 mb-0">@Message</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light px-4" @onclick="Cancel">@CancelText</button>
                <button type="button" class="btn btn-danger px-4" @onclick="Confirm">@ConfirmText</button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool show;

    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public EventCallback<bool> OnConfirmation { get; set; }

    public void Show()
    {
        show = true;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        show = false;
        await OnConfirmation.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        show = false;
        await OnConfirmation.InvokeAsync(false);
    }
}
