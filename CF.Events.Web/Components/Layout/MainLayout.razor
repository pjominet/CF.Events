@inherits LayoutComponentBase

<div class="page">
    <AuthorizeView Context="layoutAuthContext">
        <Authorized>
            @if (layoutAuthContext.User.FindFirst("must_change_password")?.Value != "true")
            {
                <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
                    <div class="container">
                        <a class="navbar-brand cursive fs-3" href="/">P&E Events</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav me-auto">
                                <AuthorizeView Roles="@Roles.User" Context="userContext">
                                    <li class="nav-item">
                                        <a class="nav-link" href="/invites">My Invites</a>
                                    </li>
                                </AuthorizeView>
                                <AuthorizeView Roles="@Roles.Admin" Context="adminContext">
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Admin
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                            <li><a class="dropdown-item" href="/admin/events">Events</a></li>
                                            <li><a class="dropdown-item" href="/admin/users">Users</a></li>
                                        </ul>
                                    </li>
                                </AuthorizeView>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @(layoutAuthContext.User.FindFirst("display_name")?.Value ?? layoutAuthContext.User.Identity?.Name ?? "Account")
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                                        <li><a class="dropdown-item" href="/account/manage">Profile</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><button class="dropdown-item text-danger" @onclick="HandleLogout">Logout</button></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            }
        </Authorized>
    </AuthorizeView>

    <main>
        <ToastContainer />
        @Body
    </main>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private AuthService AuthService { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    private async Task HandleLogout()
    {
        var provider = (ApiAuthenticationStateProvider)AuthStateProvider;
        await AuthService.LogoutAsync();
        await provider.MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/account/login");
    }
}
