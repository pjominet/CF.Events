<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
            <div class="admin-container centered-container">
                <h2 class="cursive title-cursive">Not Found</h2>
                <div class="text-center">
                    <p class="error-message">The page you're looking for doesn't exist.</p>
                    <div class="mt-20">
                        <a href="engagement" class="btn-primary">Go to Home</a>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
