@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    Layout = "_NoNavLayout";
    ViewData["Title"] = "RSVP";
}

@if (Model.NotFoundOrForbidden)
{
    <div class="container mt-5 text-center">
        <h1>Oops</h1>
        <p>Event not found or you are not invited.</p>
        <a href="/" class="btn btn-secondary">Back to Dashboard</a>
    </div>
}
else
{
    var form = Model.FormData!;
    var hasFoodDays = form.EventDays.Any(d => d.OffersFood);
    var hasAccommodation = form.ShowAccommodationOptions && form.EventDays.Any(d => d.OffersAccommodation);
    var hasCustomQuestions = form.CustomQuestions.Count > 0;

    // Build dynamic step list
    var steps = new List<(string Id, string Label)>
    {
        ("attendance", "Attendance"),
        ("group", "Group")
    };
    if (hasFoodDays) steps.Add(("food", "Food"));
    if (hasAccommodation) steps.Add(("accommodation", "Accommodation"));
    if (hasCustomQuestions) steps.Add(("extras", "Extras"));
    steps.Add(("review", "Review"));

    <div class="container py-4" style="max-width: 720px;">
        <div id="rsvp-app">
            <!-- Stepper header -->
            <div class="mb-4">
                <h4 id="rsvp-event-name" class="mb-1">@form.EventName</h4>
                @{
                    var start = form.EventStartDate.ToShortDateString();
                    var end = form.EventEndDate.ToShortDateString();
                }
                <small id="rsvp-event-dates" class="text-muted">
                    @(start == end ? start : $"{start} – {end}")
                </small>
            </div>

            <div class="d-flex justify-content-between mb-4" id="stepper-nav">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    <div class="stepper-step @(i == 0 ? "active" : "")" data-step="@i">
                        <span class="badge @(i == 0 ? "bg-primary" : "bg-secondary")">@(i + 1)</span> @step.Label
                    </div>
                }
            </div>

            <!-- Step: Attendance -->
            <div class="step-panel" data-step="0" data-step-id="attendance">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Who's attending?</h5></div>
                    <div class="card-body" id="attendance-list">
                        <partial name="RsvpSteps/_Attendance" model="form" />
                    </div>
                </div>
            </div>

            <!-- Step: Group / Plus Ones -->
            <div class="step-panel d-none" data-step="1" data-step-id="group">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Group Details</h5>
                        <button class="btn btn-sm btn-outline-primary" id="btn-add-plusone">
                            <i class="bi bi-plus-circle"></i> Add Plus One
                        </button>
                    </div>
                    <div class="card-body" id="group-details">
                        <partial name="RsvpSteps/_GroupDetails" model="form" />
                    </div>
                </div>
            </div>

            @{
                var stepIdx = 2;
            }

            <!-- Step: Food Preferences (conditional) -->
            @if (hasFoodDays)
            {
                <div class="step-panel d-none" data-step="@stepIdx" data-step-id="food">
                    <div class="card">
                        <div class="card-header"><h5 class="mb-0">Food Preferences</h5></div>
                        <div class="card-body" id="food-preferences">
                            <partial name="RsvpSteps/_FoodPreferences" model="form" />
                        </div>
                    </div>
                </div>
                stepIdx++;
            }

            <!-- Step: Accommodation (conditional) -->
            @if (hasAccommodation)
            {
                <div class="step-panel d-none" data-step="@stepIdx" data-step-id="accommodation">
                    <div class="card">
                        <div class="card-header"><h5 class="mb-0">Accommodation</h5></div>
                        <div class="card-body" id="accommodation-options">
                            <partial name="RsvpSteps/_Accommodation" model="form" />
                        </div>
                    </div>
                </div>
                stepIdx++;
            }

            <!-- Step: Custom Questions (conditional) -->
            @if (hasCustomQuestions)
            {
                <div class="step-panel d-none" data-step="@stepIdx" data-step-id="extras">
                    <div class="card">
                        <div class="card-header"><h5 class="mb-0">Additional Questions</h5></div>
                        <div class="card-body" id="custom-questions">
                            <partial name="RsvpSteps/_CustomQuestions" model="form" />
                        </div>
                    </div>
                </div>
                stepIdx++;
            }

            <!-- Step: Review & Submit -->
            <div class="step-panel d-none" data-step="@stepIdx" data-step-id="review">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Review & Submit</h5></div>
                    <div class="card-body">
                        <partial name="RsvpSteps/_Review" model="form" />
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-outline-secondary" id="btn-prev" disabled>
                    <i class="bi bi-arrow-left"></i> Previous
                </button>
                <div>
                    <button class="btn btn-primary" id="btn-next">Next <i class="bi bi-arrow-right"></i></button>
                    <button class="btn btn-success d-none" id="btn-submit">
                        <i class="bi bi-check-circle"></i> Submit RSVP
                    </button>
                </div>
            </div>
        </div>

        <!-- Success message -->
        <div id="rsvp-success" class="d-none text-center py-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            <h3 class="mt-3">RSVP Submitted!</h3>
            <p class="text-muted">Thank you for your response.</p>
            <a href="/invites" class="btn btn-primary mt-2">Back to Invites</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        const INVITATION_ID = @Model.InvitationId;
        const TOTAL_STEPS = document.querySelectorAll('.step-panel').length;
    </script>
    <script src="~/js/rsvp-stepper.js" asp-append-version="true"></script>
}

<style>
    .stepper-step {
        text-align: center;
        font-size: 0.8rem;
        cursor: pointer;
        opacity: 0.5;
        transition: opacity 0.2s;
    }
    .stepper-step.active, .stepper-step.completed {
        opacity: 1;
    }
    .stepper-step.completed .badge {
        background-color: #198754 !important;
    }
    .stepper-step.active .badge {
        background-color: #0d6efd !important;
    }
    .person-card {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .person-card.not-attending {
        opacity: 0.6;
    }
    .day-section {
        border-left: 3px solid #0d6efd;
        padding-left: 1rem;
        margin-bottom: 1.5rem;
    }
    .dietary-checks label {
        margin-right: 1rem;
    }
</style>
