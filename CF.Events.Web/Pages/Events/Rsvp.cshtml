@page "/events/{eventId:int}/rsvp"
@using CF.Events.Web.Infrastructure.Extensions
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 800px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for <strong class="fs-1">@Model.EventData.Name</strong></h2>

        @if (Model.HasResponded)
        {
            <!-- Already Responded View -->
            <div class="step-content-wrapper rounded p-4 bg-light shadow-sm">
                <div class="text-center">
                    <p class="lead cursive fs-1 mb-3">
                        @(Model.RespondedAttending ? "You have accepted the invitation!" : "You have declined the invitation.")
                    </p>
                    <p class="text-muted fst-italic mb-0">
                        <i class="bi bi-check-circle text-success me-1"></i>Your RSVP has been recorded.
                    </p>
                </div>

                @if (Model.RespondedAttending)
                {
                    <hr class="my-4"/>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h3 class="h5 serif"><i class="bi bi-calendar-check me-2"></i>Attendance</h3>
                            <ul class="list-unstyled">
                                @foreach (var pa in Model.NewRsvp.ParticipantsAttendance.OrderBy(pa => pa.ParticipantName))
                                {
                                    <li><strong>@pa.ParticipantName</strong>: Days @string.Join(", ", pa.AttendingDays.OrderBy(d => d))</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h3 class="h5 serif"><i class="bi bi-egg-fried me-2"></i>Dietary Requirements</h3>
                            @if (Model.NewRsvp.ParticipantsDiets.Any(o => o.Restrictions.Any() || !string.IsNullOrWhiteSpace(o.OtherDetails)))
                            {
                                foreach (var opt in Model.NewRsvp.ParticipantsDiets.Where(o => o.Restrictions.Any() || !string.IsNullOrWhiteSpace(o.OtherDetails)))
                                {
                                    <p class="mb-1"><strong>@opt.ParticipantName:</strong></p>
                                    @if (opt.Restrictions.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-1">
                                            @foreach (var option in opt.Restrictions)
                                            {
                                                <span class="badge bg-info text-dark">@option</span>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(opt.OtherDetails))
                                    {
                                        <p class="small text-muted mb-2">@opt.OtherDetails</p>
                                    }
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No specific dietary requirements recorded.</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-3 d-flex justify-content-center gap-2">
                <a href="/invites" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Invites
                </a>
                <form method="post" asp-page-handler="Cancel"
                      data-confirm="Are you sure you want to cancel your RSVP?">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel RSVP
                    </button>
                </form>
            </div>
        }
        else
        {
            <!-- Progress Indicator (shown only when attending) -->
            <div class="stepper-progress mb-4 d-flex justify-content-between d-none">
                <div class="step-indicator active px-2 pb-2" data-step="1">1. Participants</div>
                <div class="step-indicator px-2 pb-2" data-step="2">2. Attendance</div>
                <div class="step-indicator px-2 pb-2" data-step="3">3. Dietary Options</div>
                <div class="step-indicator px-2 pb-2" data-step="4">4. Finalize</div>
            </div>

            <form method="post" id="rsvpForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="step-content-wrapper rounded p-4 bg-light shadow-sm">
                    <!-- STEP 1: Attendance -->
                    <div class="form-step" id="step-1">
                        <p class="text-center mb-4 lead cursive fs-1">Will you be joining us?</p>
                        <section class="d-flex justify-content-center gap-4 my-2">
                            <div class="form-check custom-radio">
                                <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="true" id="accept"/>
                                <label class="form-check-label" for="accept">Happily Accept</label>
                            </div>
                            <div class="form-check custom-radio">
                                <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="false" id="decline"/>
                                <label class="form-check-label" for="decline">Regretfully Decline</label>
                            </div>
                        </section>
                    </div>

                    <!-- STEP 2: Participants -->
                    <div class="form-step d-none" id="step-2">
                        <h3 class="h5 serif text-center mb-4">Who is joining us?</h3>
                        <div id="participant-container">
                            @for (var i = 0; i < Model.NewRsvp.Participants.Count; i++)
                            {
                                <div class="row g-2 mb-2 participant-row">
                                    <div class="col">
                                        <input asp-for="NewRsvp.Participants[i]" class="form-control participant-input" placeholder="Participant Name" required />
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-sm btn-danger remove-participant"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-primary btn-sm mt-2" id="add-participant">
                            <i class="bi bi-plus-lg me-1"></i>Add Participant
                        </button>
                    </div>

                    <!-- STEP 3: Attendance Schedule & Accommodation -->
                    <div class="form-step d-none" id="step-3">
                        <h3 class="h5 serif">Attendance Schedule</h3>
                        <section class="row mb-3">
                            <div class="col-12 mt-0">
                                @for (var day = 1; day <= Model.EventData.EventDuration; day++)
                                {
                                    var attendingParticipants = Model.NewRsvp.ParticipantsAttendance
                                        .Where(pa => pa.AttendingDays.Contains(day))
                                        .Select(pa => pa.ParticipantName)
                                        .ToList();
                                    var isChecked = attendingParticipants.Any();
                                    <div class="row align-items-center mb-2">
                                        <div class="col-auto">
                                            <div class="form-check">
                                                <input class="form-check-input day-checkbox" type="checkbox" id="day-@(day)" data-day="@day"
                                                       @(isChecked ? "checked" : string.Empty)/>
                                                <label class="form-check-label" for="day-@(day)">Day @day</label>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <select class="form-select tom-select participant-day-select" multiple placeholder="Who is attending?" @(isChecked ? "" : "disabled") data-day="@day">
                                                @foreach (var p in Model.NewRsvp.Participants)
                                                {
                                                    <option value="@p" selected="@(attendingParticipants.Contains(p) ? "selected" : null)">@p</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                                @* Hidden inputs for ParticipantAttendance will be generated by JS *@
                                <div id="participant-attendance"></div>
                            </div>
                        </section>

                        @if (Model.HasAccommodationInfo())
                        {
                            <h3 class="h5 serif">Accommodation Info</h3>
                            <section>
                                <p class="mb-3">
                                    @Html.Raw(Model.EventData.AccommodationDetails)
                                </p>

                                @if (Model.EventData.BookingLinks.Any())
                                {
                                    <ol class="list-unstyled">
                                        @foreach (var bl in Model.EventData.BookingLinks.OrderBy(bl => bl.Link.Length))
                                        {
                                            <li>
                                                @switch (bl.Type)
                                                {
                                                    case LinkType.Email:
                                                        <a href="mailto:@bl.Link" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                            <i class="bi bi-envelope me-2"></i>@bl.Link
                                                        </a>
                                                        break;
                                                    case LinkType.Phone:
                                                        <a href="tel:@bl.Link.Replace(" ", string.Empty)" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                            <i class="bi bi-telephone me-2"></i>@bl.Link
                                                        </a>
                                                        break;
                                                    case LinkType.Web:
                                                        <a href="@bl.Link" target="_blank" rel="noopener" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                            <i class="bi bi-box-arrow-up-right me-2"></i>@bl.Link
                                                        </a>
                                                        break;
                                                    default:
                                                        throw new ArgumentOutOfRangeException();
                                                }
                                            </li>
                                        }
                                    </ol>
                                }
                                @if (!string.IsNullOrEmpty(Model.AssignedAccommodationCode))
                                {
                                    <div class="alert alert-info py-2 mt-3 mb-0" id="accommodationCodeAlert">
                                        <small><i class="bi bi-info-circle me-1"></i>Code: <strong>@Model.AssignedAccommodationCode</strong></small>
                                    </div>
                                }
                                <p class="text-muted mb-0 mt-2 fst-italic">
                                    <i class="bi bi-info-circle text-info me-2"></i>This information can still be viewed after finalising the RSVP.
                                </p>
                            </section>
                        }
                    </div>

                    <!-- STEP 4: Dietary Options -->
                    <div class="form-step d-none" id="step-4">
                        <section>
                            <h3 class="h5 serif">Dietary Requirements</h3>
                            <div id="dietary-participants-container">
                                @for (var i = 0; i < Model.NewRsvp.ParticipantsDiets.Count; i++)
                                {
                                    var opt = Model.NewRsvp.ParticipantsDiets[i];
                                    var hasOptions = opt.Restrictions.Any();
                                    <div class="mb-3 p-3 border rounded bg-white dietary-participant-row">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong class="participant-name-label">@opt.ParticipantName</strong>
                                            <input type="hidden" name="NewRsvp.ParticipantsDiets[@i].ParticipantName" value="@opt.ParticipantName" />
                                            <div class="form-check form-switch">
                                                <input class="form-check-input has-dietary-switch" type="checkbox" id="hasDietary_@i" @(hasOptions ? "checked" : "")>
                                                <label class="form-check-label" for="hasDietary_@i">Dietary Needs</label>
                                            </div>
                                        </div>
                                        <div class="dietary-options-wrapper @(hasOptions ? "" : "d-none")">
                                            <select name="NewRsvp.ParticipantsDiets[@i].Restrictions" class="form-select tom-select dietary-options-select" multiple placeholder="Select options...">
                                                @foreach (var option in Enum.GetValues<DietaryRestrictions>())
                                                {
                                                    if (option is DietaryRestrictions.None) continue;
                                                    <option value="@option" selected="@(opt.Restrictions.Contains(option) ? "selected" : null)">@option</option>
                                                }
                                            </select>
                                            <textarea name="NewRsvp.ParticipantsDiets[@i].OtherDetails" class="form-control mt-2" maxlength="500" placeholder="Other dietary details or allergies..." rows="2">@opt.OtherDetails</textarea>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div id="dietary-options-template" class="d-none">
                                @foreach (var option in Enum.GetValues<DietaryRestrictions>())
                                {
                                    if (option is DietaryRestrictions.None) continue;
                                    <option value="@option">@option</option>
                                }
                            </div>
                            <p class="text-muted mb-0 mt-2 fst-italic">
                                <i class="bi bi-info-circle text-info me-2"></i>Leave all empty, if none apply.
                            </p>
                        </section>
                    </div>

                    <!-- STEP 5: Comments & Donation -->
                    <div class="form-step d-none" id="step-5">
                        <section class="commentSection">
                            <h3 class="h5 serif">Comments</h3>
                            <textarea asp-for="NewRsvp.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                        </section>
                        @if (!string.IsNullOrWhiteSpace(Model.EventData.DonationIban))
                        {
                            <section class="mt-3">
                                <h3 class="h5 serif">Do you wish to help fund our event?</h3>
                                <button class="btn btn-outline-primary w-100" type="button" id="ibanInfo"
                                        onclick="copyToClipboardAndShowFeedback(this)">
                                    @Model.EventData.DonationIban.FormatAsIban()<i class="bi bi-copy ms-2"></i>
                                </button>
                                <div class="form-text text-muted mt-2 mb-0">
                                    <p>
                                        <i class="bi bi-exclamation-diamond text-danger me-2"></i>Add the reference <strong>@Model.EventData.GetDonationReference()</strong> to your transaction.
                                    </p>
                                    <p class="fst-italic">
                                        <i class="bi bi-info-circle text-info me-2"></i>Any money donated will be used to cover the cost of the event.
                                    </p>
                                </div>
                            </section>
                        }
                    </div>
                </div>

                <p class="text-muted text-center my-3" style="font-size: 0.8rem;">
                    Any information is stored securely and is only visible to the event organizers.
                </p>

                <!-- Footer Buttons -->
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div style="flex: 1 1 50%;">
                        <button type="button" class="btn btn-secondary btn-prev d-none w-100">Back</button>
                        <a href="/invites" id="cancelLink" class="btn btn-secondary w-100">Cancel</a>
                    </div>
                    <div style="flex: 1 1 50%;">
                        <button type="button" class="btn btn-primary btn-next w-100">Next</button>
                        <button class="btn btn-primary btn-submit d-none w-100" type="submit">
                            @(Model.HasResponded ? "Update RSVP" : "Send Response")
                        </button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
