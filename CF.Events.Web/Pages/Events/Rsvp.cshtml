@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    Layout = "_NoNavLayout";
    ViewData["Title"] = "RSVP";
}

@if (Model.NotFoundOrForbidden)
{
    <div class="container mt-5 text-center">
        <h1>Oops</h1>
        <p>Event not found or you are not invited.</p>
        <a href="/" class="btn btn-secondary">Back to Dashboard</a>
    </div>
}
else
{
    <div class="container py-4" style="max-width: 720px;">
        <div id="rsvp-loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading RSVP form...</p>
        </div>

        <div id="rsvp-error" class="alert alert-danger d-none"></div>

        <div id="rsvp-app" class="d-none">
            <!-- Stepper header -->
            <div class="mb-4">
                <h4 id="rsvp-event-name" class="mb-1"></h4>
                <small id="rsvp-event-dates" class="text-muted"></small>
            </div>

            <div class="d-flex justify-content-between mb-4" id="stepper-nav">
                <div class="stepper-step active" data-step="0"><span class="badge bg-primary">1</span> Attendance</div>
                <div class="stepper-step" data-step="1"><span class="badge bg-secondary">2</span> Group</div>
                <div class="stepper-step" data-step="2"><span class="badge bg-secondary">3</span> Food</div>
                <div class="stepper-step" data-step="3"><span class="badge bg-secondary">4</span> Accommodation</div>
                <div class="stepper-step" data-step="4"><span class="badge bg-secondary">5</span> Extras</div>
                <div class="stepper-step" data-step="5"><span class="badge bg-secondary">6</span> Review</div>
            </div>

            <!-- Step 0: Attendance -->
            <div class="step-panel" data-step="0">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Who's attending?</h5></div>
                    <div class="card-body" id="attendance-list"></div>
                </div>
            </div>

            <!-- Step 1: Group / Plus Ones -->
            <div class="step-panel d-none" data-step="1">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Group Details</h5>
                        <button class="btn btn-sm btn-outline-primary" id="btn-add-plusone">
                            <i class="bi bi-plus-circle"></i> Add Plus One
                        </button>
                    </div>
                    <div class="card-body" id="group-details"></div>
                </div>
            </div>

            <!-- Step 2: Food Preferences -->
            <div class="step-panel d-none" data-step="2">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Food Preferences</h5></div>
                    <div class="card-body" id="food-preferences"></div>
                </div>
            </div>

            <!-- Step 3: Accommodation -->
            <div class="step-panel d-none" data-step="3">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Accommodation</h5></div>
                    <div class="card-body" id="accommodation-options"></div>
                </div>
            </div>

            <!-- Step 4: Custom Questions -->
            <div class="step-panel d-none" data-step="4">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Additional Questions</h5></div>
                    <div class="card-body" id="custom-questions"></div>
                </div>
            </div>

            <!-- Step 5: Review & Submit -->
            <div class="step-panel d-none" data-step="5">
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Review & Submit</h5></div>
                    <div class="card-body">
                        <div id="review-summary"></div>
                        <div class="mt-3" id="comments-section">
                            <label for="rsvp-comments" class="form-label">Comments</label>
                            <textarea id="rsvp-comments" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation buttons -->
            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-outline-secondary" id="btn-prev" disabled>
                    <i class="bi bi-arrow-left"></i> Previous
                </button>
                <div>
                    <button class="btn btn-outline-primary me-2" id="btn-save-draft">Save Draft</button>
                    <button class="btn btn-primary" id="btn-next">Next <i class="bi bi-arrow-right"></i></button>
                    <button class="btn btn-success d-none" id="btn-submit">
                        <i class="bi bi-check-circle"></i> Submit RSVP
                    </button>
                </div>
            </div>
        </div>

        <!-- Success message -->
        <div id="rsvp-success" class="d-none text-center py-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            <h3 class="mt-3">RSVP Submitted!</h3>
            <p class="text-muted">Thank you for your response.</p>
            <a href="/invites" class="btn btn-primary mt-2">Back to Invites</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        const INVITATION_ID = @Model.InvitationId;
    </script>
    <script src="~/js/rsvp-stepper.js" asp-append-version="true"></script>
}

<style>
    .stepper-step {
        text-align: center;
        font-size: 0.8rem;
        cursor: pointer;
        opacity: 0.5;
        transition: opacity 0.2s;
    }
    .stepper-step.active, .stepper-step.completed {
        opacity: 1;
    }
    .stepper-step.completed .badge {
        background-color: #198754 !important;
    }
    .stepper-step.active .badge {
        background-color: #0d6efd !important;
    }
    .person-card {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .person-card.not-attending {
        opacity: 0.6;
    }
    .day-section {
        border-left: 3px solid #0d6efd;
        padding-left: 1rem;
        margin-bottom: 1.5rem;
    }
    .dietary-checks label {
        margin-right: 1rem;
    }
</style>
