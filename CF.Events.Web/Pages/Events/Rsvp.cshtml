@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 800px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for <strong>@Model.EventData?.Name</strong></h2>
        <p class="text-center mb-4">Will you be joining us?</p>
        <form method="post" id="rsvpForm" class="d-flex flex-column gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="d-flex justify-content-center gap-4 my-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="true" id="accept"/>
                    <label class="form-check-label" for="accept">Happily Accept</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="false" id="decline"/>
                    <label class="form-check-label" for="decline">Regretfully Decline</label>
                </div>
            </div>

            <div id="additionalOptions" class="d-flex flex-column gap-3 mt-2" style="display:@(Model.Input.Attending ? "block" : "none")">
                <div class="row g-3 justify-content-center">
                    @if (Model.EventData?.EventConfig?.AllowPartners == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.BringsPlusOne" id="plusOne"/>
                                <label class="form-check-label" for="plusOne">Bringing a +1?</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.AllowKids == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.BringsKids" id="kids"/>
                                <label class="form-check-label" for="kids">Bringing kids?</label>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.EventData?.EventConfig?.AllowKids == true)
                {
                    <div id="kidsDetailsSection" style="display: @(Model.Input.BringsKids ? "block" : "none")">
                        <h6 class="serif mb-2">Kids Details</h6>
                        <div id="kidsRowsContainer" class="d-flex flex-column gap-2 mb-3">
                            @foreach (var bracket in Enum.GetValues<KidAgeBracket>())
                            {
                                var count = Model.Input.KidsDetails.TryGetValue(bracket, out var c) ? c : 0;
                                <div class="row align-items-center kids-row @(count > 0 ? "" : "d-none")" data-bracket="@bracket">
                                    <div class="col-7">
                                        <span class="text-capitalize">@bracket.ToString().Replace("To", " to ").Replace("Or", " or ")</span>
                                    </div>
                                    <div class="col-5">
                                        <input type="number" name="Input.KidsDetails[@bracket]" value="@count" class="form-control form-control-sm kid-count-input" min="0"/>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="row g-2">
                            <div class="col-8">
                                <select id="kidAgeBracketSelect" class="form-select form-select-sm">
                                    <option value="">Add age bracket...</option>
                                    @foreach (var bracket in Enum.GetValues<KidAgeBracket>())
                                    {
                                        <option value="@bracket">@bracket.ToString().Replace("To", " to ").Replace("Or", " or ")</option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <button type="button" id="addKidBracketBtn" class="btn btn-outline-primary btn-sm w-100">Add</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="row g-3 justify-content-center">
                    @if (Model.EventData?.EventConfig?.OfferBreakfast == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForBreakfast" id="breakfast"/>
                                <label class="form-check-label" for="breakfast">Joining Breakfast</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferBrunch == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForBrunch" id="brunch"/>
                                <label class="form-check-label" for="brunch">Joining Brunch</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferLunch == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForLunch" id="lunch"/>
                                <label class="form-check-label" for="lunch">Joining Lunch</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferDinner == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForDinner" id="dinner"/>
                                <label class="form-check-label" for="dinner">Joining Dinner</label>
                            </div>
                        </div>
                    }
                </div>

                @{
                    var showDietaryOptions = Model.EventData?.EventConfig?.OfferDinner == true
                                             || Model.EventData?.EventConfig?.OfferLunch == true
                                             || Model.EventData?.EventConfig?.OfferBreakfast == true
                                             || Model.EventData?.EventConfig?.OfferBrunch == true;
                    var anyFoodSelected = Model.Input.JoinsForBreakfast
                                          || Model.Input.JoinsForBrunch
                                          || Model.Input.JoinsForLunch
                                          || Model.Input.JoinsForDinner;
                    if (showDietaryOptions)
                    {
                        <div id="dietarySection" style="display: @(anyFoodSelected ? "block" : "none")">
                            <div class="mt-2">
                                <label class="form-label serif">Dietary Requirements</label>
                                <select asp-for="Input.CommonDietaryOptions" class="form-select tom-select" id="dietaryOptions" multiple placeholder="Select dietary options...">
                                    @foreach (var option in Enum.GetValues<DietaryOptions>())
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </div>
                            <div class="mt-2">
                                <textarea asp-for="Input.OtherDietaryDetails" class="form-control" maxlength="500" placeholder="Other dietary details or allergies..." rows="2"></textarea>
                            </div>
                        </div>
                    }
                }

                @if (Model.EventData?.EventConfig?.ShowAccommodationOptions == true)
                {
                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.NeedsAccommodation" id="accommodation"/>
                                <label class="form-check-label" for="accommodation">Need Accommodation?</label>
                            </div>
                        </div>
                        <div class="col" id="accommodationDurationWrapper" style="display: @(Model.Input.NeedsAccommodation ? "block" : "none")">
                            <div class="input-group input-group-sm">
                                <input asp-for="Input.AccommodationDuration" type="number" class="form-control" min="1" placeholder="Duration"/>
                                <span class="input-group-text">days</span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.EventData?.AccommodationCode))
                    {
                        <div class="alert alert-info py-2 mb-0" id="accommodationCodeAlert" style="display: @(Model.Input.NeedsAccommodation ? "block" : "none")">
                            <small><i class="bi bi-info-circle me-1"></i>Accommodation Code: <strong>@Model.EventData.AccommodationCode</strong></small>
                        </div>
                    }
                }

                @if (Model.EventData?.EventConfig?.AllowComments == true)
                {
                    <div>
                        <textarea asp-for="Input.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                    </div>
                }
            </div>

            <p class="d-flex justify-content-center my-2 text-muted text-center" style="font-size: 0.8rem;">
                Information will be stored confidentially and is only visible to the event organizers.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    @(Model.HasResponded ? "Update RSVP" : "Send Response")
                </button>
                <a href="/invites" class="btn btn-secondary flex-grow-1 d-flex align-items-center justify-content-center">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
