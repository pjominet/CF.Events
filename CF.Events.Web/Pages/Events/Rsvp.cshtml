@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    Layout = "_GlassLayout";
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card bg-glass border-glass p-4 mx-auto rounded-5" style="max-width: 800px; width: 100%;">
        @*<h2 class="serif text-center text-white mb-4">RSVP for <strong class="fs-1">@Model.EventData.Name</strong></h2>*@

        @if (Model.HasResponded)
        {
            <!-- Already Responded View -->
            <div class="step-content-wrapper rounded p-4 bg-light shadow-sm">
                <div class="text-center">
                    <p class="lead cursive fs-1 mb-3">
                        @(Model.RespondedAttending ? "You have accepted the invitation!" : "You have declined the invitation.")
                    </p>
                    <p class="text-muted fst-italic mb-0">
                        <i class="bi bi-check-circle text-success me-1"></i>Your RSVP has been recorded.
                    </p>
                </div>

                @if (Model.RespondedAttending)
                {
                    <hr class="my-4"/>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h3 class="text-center mb-4 cursive fs-1"><i class="bi bi-calendar-check me-2"></i>Attendance</h3>
                            <ul class="list-unstyled">
                                @foreach (var pa in Model.NewRsvp.ParticipantsAttendance.OrderBy(pa => pa.ParticipantName))
                                {
                                    <li><strong>@pa.ParticipantName</strong>: Days @string.Join(", ", pa.AttendingDays.OrderBy(d => d))</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h3 class="text-center mb-4 cursive fs-1"><i class="bi bi-egg-fried me-2"></i>Dietary Requirements</h3>
                            @if (Model.NewRsvp.ParticipantsDiets.Any(o => o.Restrictions.Any() || !string.IsNullOrWhiteSpace(o.OtherDetails)))
                            {
                                foreach (var opt in Model.NewRsvp.ParticipantsDiets.Where(o => o.Restrictions.Any() || !string.IsNullOrWhiteSpace(o.OtherDetails)))
                                {
                                    <p class="mb-1"><strong>@opt.ParticipantName:</strong></p>
                                    if (opt.Restrictions.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-1">
                                            @foreach (var option in opt.Restrictions)
                                            {
                                                <span class="badge bg-info text-dark">@option</span>
                                            }
                                        </div>
                                    }
                                    if (!string.IsNullOrWhiteSpace(opt.OtherDetails))
                                    {
                                        <p class="small text-muted mb-2">@opt.OtherDetails</p>
                                    }
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No specific dietary requirements recorded.</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-3 d-flex justify-content-center gap-2">
                <a href="/invites" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Invite
                </a>
                <form method="post" asp-page-handler="Cancel"
                      data-confirm="Are you sure you want to cancel your RSVP?">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel RSVP
                    </button>
                </form>
            </div>
        }
        else
        {
            <!-- Progress Indicator (shown only when attending) -->
            <div class="stepper-progress mb-4 d-flex justify-content-between d-none">
                <div class="step-indicator active px-2 pb-2" data-step="1">1. Participants</div>
                <div class="step-indicator px-2 pb-2" data-step="2">2. Attendance</div>
                <div class="step-indicator px-2 pb-2" data-step="3">3. Dietary Requirements</div>
                <div class="step-indicator px-2 pb-2" data-step="4">4. Finalize</div>
            </div>

            <form method="post" id="rsvpForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="step-content-wrapper rounded-5 p-4 bg-card-custom shadow-sm">
                    <!-- STEP 1: Attendance -->
                    <div class="form-step" id="step-1">
                        <h3 class="text-center mb-4 cursive fs-1">Will you be joining us?</h3>
                        <section class="d-flex justify-content-center gap-4 my-2">
                            <div class="form-check custom-radio">
                                <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="true" id="accept"/>
                                <label class="form-check-label" for="accept">Happily Accept</label>
                            </div>
                            <div class="form-check custom-radio">
                                <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="false" id="decline"/>
                                <label class="form-check-label" for="decline">Regretfully Decline</label>
                            </div>
                        </section>
                    </div>

                    <!-- STEP 2: Participants -->
                    <div class="form-step d-none" id="step-2">
                        <h3 class="h5 serif">Who is joining us?</h3>
                        <partial name="Shared/_RsvpParticipants" model="(Model.NewRsvp.Participants, Model.EventData.MaxParticipantsPerRsvp)" />
                    </div>

                    <!-- STEP 3: Attendance Schedule & Accommodation -->
                    <div class="form-step d-none" id="step-3">
                        <h3 class="h5 serif">Attendance</h3>
                        <section class="row mb-3">
                            <div class="col-12 mt-0">
                                <partial name="Shared/_RsvpAttendanceSchedule" model="(Model.EventData.EventDuration, Model.NewRsvp.Participants, Model.NewRsvp.ParticipantsAttendance)" />
                            </div>
                        </section>
                    </div>

                    <!-- STEP 4: Dietary Options -->
                    <div class="form-step d-none" id="step-4">
                        <section>
                            <h3 class="h5 serif">Dietary Requirements</h3>
                            <partial name="Shared/_RsvpDietaryOptions" model="(Model.NewRsvp.Participants, Model.NewRsvp.ParticipantsDiets)" />
                            <p class="text-muted mb-0 mt-2 fst-italic">
                                <i class="bi bi-info-circle text-info me-2"></i>Leave all empty, if none apply.
                            </p>
                        </section>
                    </div>

                    <!-- STEP 5: Comments & Donation -->
                    <div class="form-step d-none" id="step-5">
                        <section class="commentSection">
                            <h3 class="h5 serif">Comments</h3>
                            <textarea asp-for="NewRsvp.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                        </section>
                    </div>
                </div>

                <p class="text-muted text-center my-3" style="font-size: 0.8rem;">
                    Any information is stored securely and is only visible to the event organizers.
                </p>

                <!-- Footer Buttons -->
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div style="flex: 1 1 50%;">
                        <button type="button" class="btn btn-rsvp btn-secondary btn-prev d-none w-100">Back</button>
                        <a href="/invites" id="cancelLink" class="btn btn-secondary w-100">Cancel</a>
                    </div>
                    <div style="flex: 1 1 50%;">
                        <button type="button" class="btn btn-rsvp btn-primary btn-next w-100">Next</button>
                        <button class="btn btn-primary btn-submit d-none w-100" type="submit">
                            @(Model.HasResponded ? "Update RSVP" : "Send Response")
                        </button>
                    </div>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <style>
        .admin-only { display: none !important; }
    </style>
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
