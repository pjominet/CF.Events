@page "/events/{eventId:int}/rsvp"
@using CF.Events.Web.Infrastructure.Extensions
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 800px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for <strong class="fs-1">@Model.EventData.Name</strong></h2>

        @if (Model.HasResponded)
        {
            <!-- Already Responded View -->
            <div class="step-content-wrapper rounded p-4 bg-light shadow-sm text-center">
                <p class="lead cursive fs-1 mb-3">
                    @(Model.RespondedAttending ? "You have accepted the invitation!" : "You have declined the invitation.")
                </p>
                <p class="text-muted fst-italic mb-0">
                    <i class="bi bi-check-circle text-success me-1"></i>Your RSVP has been recorded.
                </p>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                @if (Model.HasAccommodationInfo() || !string.IsNullOrWhiteSpace(Model.EventData.DonationIban))
                {
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#eventInfoModal">
                        <i class="bi bi-info-circle me-1"></i>View Event Info
                    </button>
                }
                <a href="/events/@Model.EventData.Id/rsvp" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>Edit RSVP
                </a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelRsvpModal">
                    <i class="bi bi-x-circle me-1"></i>Cancel RSVP
                </button>
            </div>

            <div class="text-center mt-3">
                <a href="/invites" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Invites
                </a>
            </div>

            <!-- Event Info Modal (readonly) -->
            @if (Model.HasAccommodationInfo() || !string.IsNullOrWhiteSpace(Model.EventData.DonationIban))
            {
                <div class="modal fade" id="eventInfoModal" tabindex="-1" aria-labelledby="eventInfoModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title serif" id="eventInfoModalLabel">Event Information</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                @if (Model.HasAccommodationInfo())
                                {
                                    <h6 class="serif"><i class="bi bi-house me-1"></i>Accommodation Info</h6>
                                    @if (!string.IsNullOrWhiteSpace(Model.EventData.AccommodationDetails))
                                    {
                                        <p class="mb-3">@Html.Raw(Model.EventData.AccommodationDetails)</p>
                                    }
                                    @if (Model.EventData.BookingLinks.Any())
                                    {
                                        <ol class="list-unstyled">
                                            @foreach (var bl in Model.EventData.BookingLinks.OrderBy(bl => bl.Link.Length))
                                            {
                                                <li>
                                                    @switch (bl.Type)
                                                    {
                                                        case LinkType.Email:
                                                            <a href="mailto:@bl.Link" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                                <i class="bi bi-envelope me-2"></i>@bl.Link
                                                            </a>
                                                            break;
                                                        case LinkType.Phone:
                                                            <a href="tel:@bl.Link.Replace(" ", string.Empty)" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                                <i class="bi bi-telephone me-2"></i>@bl.Link
                                                            </a>
                                                            break;
                                                        case LinkType.Web:
                                                            <a href="@bl.Link" target="_blank" rel="noopener" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                                <i class="bi bi-box-arrow-up-right me-2"></i>@bl.Link
                                                            </a>
                                                            break;
                                                        default:
                                                            throw new ArgumentOutOfRangeException();
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.AssignedAccommodationCode))
                                    {
                                        <div class="alert alert-info py-2 mt-3 mb-0">
                                            <small><i class="bi bi-info-circle me-1"></i>Code: <strong>@Model.AssignedAccommodationCode</strong></small>
                                        </div>
                                    }
                                    <hr />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.EventData.DonationIban))
                                {
                                    <h6 class="serif"><i class="bi bi-heart me-1"></i>Help Fund Our Event</h6>
                                    <button class="btn btn-outline-primary w-100" type="button"
                                            onclick="copyToClipboardAndShowFeedback(this)">
                                        @Model.EventData.DonationIban.FormatAsIban()<i class="bi bi-copy ms-2"></i>
                                    </button>
                                    <div class="form-text text-muted mt-2 mb-0">
                                        <p>
                                            <i class="bi bi-exclamation-diamond text-danger me-2"></i>Add the reference <strong>@($"{Model.EventData.Name}{Model.EventData.StartDate.Year}")</strong> to your transaction.
                                        </p>
                                        <p class="fst-italic">
                                            <i class="bi bi-info-circle text-info me-2"></i>Any money donated will be used to cover the cost of the event.
                                        </p>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Cancel RSVP Confirmation Modal -->
            <div class="modal fade" id="cancelRsvpModal" tabindex="-1" aria-labelledby="cancelRsvpModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title serif" id="cancelRsvpModalLabel">Cancel RSVP</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to cancel your RSVP? You will be able to submit a new response afterwards.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep RSVP</button>
                            <form method="post" asp-page-handler="Cancel">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-x-circle me-1"></i>Cancel RSVP
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
        <!-- Progress Indicator (shown only when attending) -->
        <div class="stepper-progress mb-4 d-flex justify-content-between d-none">
            <div class="step-indicator active px-2 pb-2" data-step="1">1. Attendance</div>
            <div class="step-indicator px-2 pb-2" data-step="2">2. Dietary Options</div>
            <div class="step-indicator px-2 pb-2" data-step="3">3. Finalize</div>
        </div>

        <form method="post" id="rsvpForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="step-content-wrapper rounded p-4 bg-light shadow-sm">
                <!-- STEP 1: Attendance -->
                <div class="form-step" id="step-1">
                    <p class="text-center mb-4 lead cursive fs-1">Will you be joining us?</p>
                    <section class="d-flex justify-content-center gap-4 my-2">
                        <div class="form-check custom-radio">
                            <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="true" id="accept"/>
                            <label class="form-check-label" for="accept">Happily Accept</label>
                        </div>
                        <div class="form-check custom-radio">
                            <input class="form-check-input" type="radio" asp-for="NewRsvp.Attending" value="false" id="decline"/>
                            <label class="form-check-label" for="decline">Regretfully Decline</label>
                        </div>
                    </section>
                </div>

                <!-- STEP 2: Attendance Schedule & Accommodation -->
                <div class="form-step d-none" id="step-2">
                    <h3 class="h5 serif">Attendance Schedule</h3>
                    <section class="row mb-3">
                        <div class="col-12 mt-0">
                            @for (var day = 1; day <= Model.EventData.EventDuration; day++)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="NewRsvp.AttendanceDays" id="day-@(day)" value="@day"
                                           @(Model.NewRsvp.AttendanceDays.Contains(day) ? "checked" : string.Empty)/>
                                    <label class="form-check-label" for="day-@(day)">Attending Day @day</label>
                                </div>
                            }
                        </div>
                    </section>

                    @if (Model.HasAccommodationInfo())
                    {
                        <h3 class="h5 serif">Accommodation Info</h3>
                        <section>
                            <p class="mb-3">
                                @Html.Raw(Model.EventData.AccommodationDetails)
                            </p>

                            @if (Model.EventData.BookingLinks.Any())
                            {
                                <ol class="list-unstyled">
                                    @foreach (var bl in Model.EventData.BookingLinks.OrderBy(bl => bl.Link.Length))
                                    {
                                        <li>
                                            @switch (bl.Type)
                                            {
                                                case LinkType.Email:
                                                    <a href="mailto:@bl.Link" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                        <i class="bi bi-envelope me-2"></i>@bl.Link
                                                    </a>
                                                    break;
                                                case LinkType.Phone:
                                                    <a href="tel:@bl.Link.Replace(" ", string.Empty)" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                        <i class="bi bi-telephone me-2"></i>@bl.Link
                                                    </a>
                                                    break;
                                                case LinkType.Web:
                                                    <a href="@bl.Link" target="_blank" rel="noopener" class="btn btn-sm btn-primary mb-1 px-2 py-1">
                                                        <i class="bi bi-box-arrow-up-right me-2"></i>@bl.Link
                                                    </a>
                                                    break;
                                                default:
                                                    throw new ArgumentOutOfRangeException();
                                            }
                                        </li>
                                    }
                                </ol>
                            }
                            @if (!string.IsNullOrEmpty(Model.AssignedAccommodationCode))
                            {
                                <div class="alert alert-info py-2 mt-3 mb-0" id="accommodationCodeAlert">
                                    <small><i class="bi bi-info-circle me-1"></i>Code: <strong>@Model.AssignedAccommodationCode</strong></small>
                                </div>
                            }
                            <p class="text-muted mb-0 mt-2 fst-italic">
                                <i class="bi bi-info-circle text-info me-2"></i>This information can still be viewed after finalising the RSVP.
                            </p>
                        </section>
                    }
                </div>

                <!-- STEP 3: Dietary Options -->
                <div class="form-step d-none" id="step-3">
                    <section>
                        <h3 class="h5 serif">Dietary Requirements</h3>
                        <select asp-for="NewRsvp.CommonDietaryOptions" class="form-select tom-select" id="dietaryOptions" multiple placeholder="Select dietary options...">
                            @foreach (var option in Enum.GetValues<DietaryOptions>())
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                        <textarea asp-for="NewRsvp.OtherDietaryDetails" class="form-control mt-2" maxlength="500" placeholder="Other dietary details or allergies..." rows="2"></textarea>
                        <p class="text-muted mb-0 mt-2 fst-italic">
                            <i class="bi bi-info-circle text-info me-2"></i>Leave all empty, if none apply.
                        </p>
                    </section>
                </div>

                <!-- STEP 4: Comments & Donation -->
                <div class="form-step d-none" id="step-4">
                    <section class="commentSection">
                        <h3 class="h5 serif">Comments</h3>
                        <textarea asp-for="NewRsvp.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                    </section>
                    @if (!string.IsNullOrWhiteSpace(Model.EventData.DonationIban))
                    {
                        <section class="mt-3">
                            <h3 class="h5 serif">You are welcome to help fund our event</h3>
                            <button class="btn btn-outline-primary w-100" type="button" id="ibanInfo"
                                    onclick="copyToClipboardAndShowFeedback(this)">
                                @Model.EventData.DonationIban.FormatAsIban()<i class="bi bi-copy ms-2"></i>
                            </button>
                            <div class="form-text text-muted mt-2 mb-0">
                                <p>
                                    <i class="bi bi-exclamation-diamond text-danger me-2"></i>Add the reference <strong>@($"{Model.EventData.Name}{Model.EventData.StartDate.Year}")</strong> to your transaction.
                                </p>
                                <p class="fst-italic">
                                    <i class="bi bi-info-circle text-info me-2"></i>Any money donated will be used to cover the cost of the event.
                                </p>
                            </div>
                        </section>
                    }
                </div>
            </div>

            <p class="text-muted text-center my-3" style="font-size: 0.8rem;">
                Any information is stored securely and is only visible to the event organizers.
            </p>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div style="flex: 1 1 50%;">
                    <button type="button" class="btn btn-secondary btn-prev d-none w-100">Back</button>
                    <a href="/invites" id="cancelLink" class="btn btn-secondary w-100">Cancel</a>
                </div>
                <div style="flex: 1 1 50%;">
                    <button type="button" class="btn btn-primary btn-next w-100">Next</button>
                    <button class="btn btn-primary btn-submit d-none w-100" type="submit">
                        @(Model.HasResponded ? "Update RSVP" : "Send Response")
                    </button>
                </div>
            </div>
        </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
