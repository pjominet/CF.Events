@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 800px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for <strong>@Model.EventData.Name</strong></h2>
        <p class="text-center mb-4">Will you be joining us?</p>
        <form method="post" id="rsvpForm" class="d-flex flex-column gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="d-flex justify-content-center gap-4 my-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="true" id="accept"/>
                    <label class="form-check-label" for="accept">Happily Accept</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="false" id="decline"/>
                    <label class="form-check-label" for="decline">Regretfully Decline</label>
                </div>
            </div>

            <div id="additionalOptions" class="d-flex flex-column gap-3 mt-2" style="display:@(Model.Input.Attending ? "block" : "none")">
                <div class="row g-3 justify-content-center">
                    <div class="col-auto">
                        @for (var day = 1; day <= Model.EventData.EventDuration; day++)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.SelectedDays" id="day-@(day)" value="@day"/>
                                <label class="form-check-label" for="day-@(day)">Attending Day @day</label>
                            </div>
                        }
                    </div>
                </div>

                <div id="dietarySection">
                    <div class="mt-2">
                        <label class="form-label serif">Dietary Requirements</label>
                        <select asp-for="Input.CommonDietaryOptions" class="form-select tom-select" id="dietaryOptions" multiple placeholder="Select dietary options...">
                            @foreach (var option in Enum.GetValues<DietaryOptions>())
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="mt-2">
                        <textarea asp-for="Input.OtherDietaryDetails" class="form-control" maxlength="500" placeholder="Other dietary details or allergies..." rows="2"></textarea>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.AssignedAccommodationCode))
                {
                    <div class="alert alert-info py-2 mb-0" id="accommodationCodeAlert">
                        <small><i class="bi bi-info-circle me-1"></i>Accommodation Code: <strong>@Model.AssignedAccommodationCode</strong></small>
                    </div>
                }
                <div>
                    <textarea asp-for="Input.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                </div>
            </div>

            <p class="d-flex justify-content-center my-2 text-muted text-center" style="font-size: 0.8rem;">
                Information will be stored confidentially and is only visible to the event organizers.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    @(Model.HasResponded ? "Update RSVP" : "Send Response")
                </button>
                <a href="/invites" class="btn btn-secondary flex-grow-1 d-flex align-items-center justify-content-center">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
