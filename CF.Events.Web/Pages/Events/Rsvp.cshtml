@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid d-flex justify-content-center pt-4 mb-auto">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 800px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for <strong class="fs-1">@Model.EventData.Name</strong></h2>
        <!-- Progress Indicator -->
        <div class="stepper-progress mb-4 d-flex justify-content-between">
            <div class="step-indicator active px-2 pb-2" data-step="1">1. Attendance</div>
            <div class="step-indicator px-2 pb-2" data-step="2">2. Details</div>
            <div class="step-indicator px-2 pb-2" data-step="3">3. Finalize</div>
        </div>

        <form method="post" id="rsvpForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="step-content-wrapper rounded p-4 bg-light shadow-sm">
                <!-- STEP 1: Attendance -->
                <div class="form-step" id="step-1">
                    <p class="text-center mb-4 lead cursive fs-1">Will you be joining us?</p>
                    <section class="d-flex justify-content-center gap-4 my-2">
                        <div class="form-check custom-radio">
                            <input class="form-check-input" type="radio" asp-for="Input.Attending" value="true" id="accept"/>
                            <label class="form-check-label" for="accept">Happily Accept</label>
                        </div>
                        <div class="form-check custom-radio">
                            <input class="form-check-input" type="radio" asp-for="Input.Attending" value="false" id="decline"/>
                            <label class="form-check-label" for="decline">Regretfully Decline</label>
                        </div>
                    </section>
                </div>

                <!-- STEP 2: Attendance Days & Accommodation -->
                <div class="form-step d-none" id="step-2">
                    <div class="d-flex flex-column gap-3">
                        <label class="form-label serif h5">Attendance Schedule</label>
                        <section class="row g-3">
                            <div class="col-12">
                                @for (var day = 1; day <= Model.EventData.EventDuration; day++)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Input.AttendanceDays" id="day-@(day)" value="@day"
                                               @(Model.Input.AttendanceDays.Contains(day) ? "checked" : string.Empty)/>
                                        <label class="form-check-label" for="day-@(day)">Attending Day @day</label>
                                    </div>
                                }
                            </div>
                        </section>

                        <hr/>

                        <section>
                            @{
                                var hasAccommodation = !string.IsNullOrEmpty(Model.AssignedAccommodationCode);
                                <div class="d-flex align-items-center gap-2">
                                    <label class="form-check-label text-nowrap" for="nights">Reserve a room for</label>
                                    <div class="input-group">
                                        <input class="form-control" type="number" min="1" max="@(Model.EventData.EventDuration + 2)" step="1"
                                               asp-for="Input.AccommodationNights" id="nights" style="max-width: 5rem"/>
                                        <div class="input-group-text">nights</div>
                                    </div>
                                </div>
                            }
                            @if (hasAccommodation)
                            {
                                <div class="alert alert-info py-2 mt-3 mb-0" id="accommodationCodeAlert">
                                    <small><i class="bi bi-info-circle me-1"></i>Code: <strong>@Model.AssignedAccommodationCode</strong></small>
                                </div>
                            }
                        </section>
                    </div>
                </div>

                <!-- STEP 3: Dietary & Comments -->
                <div class="form-step d-none" id="step-3">
                    <section>
                        <div class="mt-2">
                            <label class="form-label serif h5">Dietary Requirements</label>
                            <select asp-for="Input.CommonDietaryOptions" class="form-select tom-select" id="dietaryOptions" multiple placeholder="Select dietary options...">
                                @foreach (var option in Enum.GetValues<DietaryOptions>())
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                        <div class="mt-3">
                            <textarea asp-for="Input.OtherDietaryDetails" class="form-control" maxlength="500" placeholder="Other dietary details or allergies..." rows="2"></textarea>
                        </div>
                    </section>

                    <section class="mt-4">
                        <label class="form-label serif h5">Comments</label>
                        <textarea asp-for="Input.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                    </section>
                </div>
            </div>

            <p class="text-muted text-center my-3" style="font-size: 0.8rem;">
                Any information is stored securely and is only visible to the event organizers.
            </p>

            <!-- Footer Buttons -->
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div style="flex: 1 1 50%;">
                    <button type="button" class="btn btn-secondary btn-prev d-none w-100">Back</button>
                    <a href="/invites" id="cancelLink" class="btn btn-secondary w-100">Cancel</a>
                </div>
                <div style="flex: 1 1 50%;">
                    <button type="button" class="btn btn-primary btn-next w-100">Next</button>
                    <button class="btn btn-primary btn-submit d-none w-100" type="submit">
                        @(Model.HasResponded ? "Update RSVP" : "Send Response")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .step-indicator {
        opacity: 0.5;
        font-weight: bold;
        border-bottom: 3px solid #dee2e6;
        flex: 1;
        text-align: center;
        transition: all 0.3s ease;
    }
    .step-indicator.active {
        opacity: 1;
        border-bottom: 3px solid var(--bs-primary);
        color: var(--bs-primary);
    }
    .step-content-wrapper {
        min-height: 250px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .custom-radio .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.125em;
    }
    .btn {
        padding: 0.6rem 1rem;
        font-weight: 500;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
}
