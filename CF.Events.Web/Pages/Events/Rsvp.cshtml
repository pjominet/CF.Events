@page "/events/{eventId:int}/rsvp"
@model CF.Events.Web.Pages.Events.RsvpModel
@{
    ViewData["Title"] = "RSVP";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded shadow-sm" style="max-width: 500px; width: 100%;">
        <h2 class="serif text-center mb-4">RSVP for @Model.EventData?.Name</h2>

        <p class="text-center mb-4">Will you be joining us?</p>
        <form method="post" id="rsvpForm" class="d-flex flex-column gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="d-flex justify-content-center gap-4 my-2">
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="true" id="accept" />
                    <label class="form-check-label" for="accept">Happily Accept</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.Attending" value="false" id="decline" />
                    <label class="form-check-label" for="decline">Regretfully Decline</label>
                </div>
            </div>

            <div id="additionalOptions" class="d-flex flex-column gap-3 mt-2" style="display:@(Model.Input.Attending ? "block" : "none")">
                <div class="row g-3 justify-content-center">
                    @if (Model.EventData?.EventConfig?.AllowPartners == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.BringsPlusOne" id="plusOne" />
                                <label class="form-check-label" for="plusOne">Bringing a +1?</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.AllowKids == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.BringsKids" id="kids" />
                                <label class="form-check-label" for="kids">Bringing kids?</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="row g-3 justify-content-center">
                    @if (Model.EventData?.EventConfig?.OfferBreakfast == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForBreakfast" id="breakfast" />
                                <label class="form-check-label" for="breakfast">Breakfast?</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferBrunch == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForBrunch" id="brunch" />
                                <label class="form-check-label" for="brunch">Brunch?</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferLunch == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForLunch" id="lunch" />
                                <label class="form-check-label" for="lunch">Lunch?</label>
                            </div>
                        </div>
                    }
                    @if (Model.EventData?.EventConfig?.OfferDinner == true)
                    {
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.JoinsForDinner" id="dinner" />
                                <label class="form-check-label" for="dinner">Dinner?</label>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.EventData?.EventConfig?.ShowAccommodationOptions == true)
                {
                    <div class="row g-3 justify-content-center">
                        <div class="col-auto">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Input.NeedsAccommodation" id="accommodation" />
                                <label class="form-check-label" for="accommodation">Need Accommodation?</label>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.EventData?.EventConfig?.AllowComments == true)
                {
                    <div>
                        <textarea asp-for="Input.Comments" class="form-control" maxlength="500" placeholder="Add a comment... (optional)" rows="3"></textarea>
                    </div>
                }
            </div>

            <p class="d-flex justify-content-center my-2 text-muted text-center" style="font-size: 0.8rem;">
                Information will be stored confidentially and is only visible to the event organizers.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">
                    @(Model.HasResponded ? "Update RSVP" : "Send Response")
                </button>
                <a href="/events/@Model.EventData?.Id/invitation" class="btn btn-secondary flex-grow-1 d-flex align-items-center justify-content-center">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
            <script>
                (function () {
                    var options = document.getElementById("additionalOptions");
                    document.querySelectorAll('input[name="Input.Attending"]').forEach(function (radio) {
                        radio.addEventListener("change", function () {
                            options.style.display = (this.value === "true" || this.value === "True") ? "block" : "none";
                        });
                    });
                })();
            </script>
}
