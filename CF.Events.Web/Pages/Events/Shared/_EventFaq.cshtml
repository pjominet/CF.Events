@model List<EventFaqItem>

<div class="modal fade" id="eventFaqModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title serif h3">FAQ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="accordion" id="faqAccordion">
                    @if (Model.Count > 0)
                    {
                        for (var i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i == 0 ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#faq-@i">
                                        <strong>@item.Question</strong>
                                    </button>
                                </h2>
                                <div id="faq-@i" class="accordion-collapse collapse @(i == 0 ? "show" : string.Empty)">
                                    <div class="accordion-body">
                                        @Html.Raw(item.Answer)
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info py-2 mt-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>No FAQ has been configured for this event
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


