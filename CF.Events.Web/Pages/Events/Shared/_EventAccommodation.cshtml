@using CF.Events.Web.Infrastructure.Extensions
@model AccommodationDetails

<div class="modal fade" id="eventAccommodationModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title serif h3">Accommodation Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model is { IsAttending: false, HasRsvped: true })
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-info-circle me-2"></i>You have indicated that you will not be attending this event.
                    </div>
                }

                @if (Model.Details.HasValue(false))
                {
                    <p class="mb-4">@Html.Raw(Model.Details)</p>
                }

                @if (Model.BookingLinks.Any())
                {
                    <div class="d-flex gap-3">
                        @foreach (var (type, link) in Model.BookingLinks)
                        {
                            switch (type)
                            {
                                case LinkType.Email:
                                    <a href="mailto:@link" class="btn btn-primary mb-1 px-2 py-1">
                                        <i class="bi bi-envelope me-2"></i>@link
                                    </a>
                                    break;
                                case LinkType.Phone:
                                    <a href="tel:@link.Replace(" ", string.Empty)" class="btn btn-primary mb-1 px-2 py-1">
                                        <i class="bi bi-telephone me-2"></i>@link
                                    </a>
                                    break;
                                case LinkType.Web:
                                    <a href="@link" target="_blank" rel="noopener" class="btn btn-primary mb-1 px-2 py-1">
                                        <i class="bi bi-box-arrow-up-right me-2"></i>@link
                                    </a>
                                    break;
                                default:
                                    throw new ArgumentOutOfRangeException();
                            }
                        }
                    </div>
                }

                @if (Model.Code.HasValue())
                {
                    <div class="alert alert-info py-2 mt-3 mb-0">
                        <small><i class="bi bi-info-circle me-1"></i>Code: <strong>@Model.Code</strong></small>
                    </div>
                }

                @if (!Model.Details.HasValue() && !Model.Code.HasValue() && !Model.BookingLinks.Any())
                {
                    <div class="alert alert-info py-2 mt-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>This event does not have any further accommodation details.
                    </div>
                }

            </div>
        </div>
    </div>
</div>
