@model string

<div class="modal fade" id="eventTravelModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title serif">Travel Instructions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(Model))
                {
                    <jsonrenderer input="@Model"/>
                }
                else
                {
                    <div class="alert alert-info py-2 mt-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>This event does not provide any travel information.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
