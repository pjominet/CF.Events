@model List<EventScheduleStep>

<div class="modal fade" id="eventScheduleModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title serif h3">Event Schedule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @foreach (var day in Model.GroupBy(s => s.Day))
                {
                    <label>Day @day.Key</label>
                    <ul>
                        @foreach (var step in day)
                        {
                            <li>@step.TimeStamp - @step.Label</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

