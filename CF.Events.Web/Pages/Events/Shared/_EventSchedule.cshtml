@model EventScheduleViewModel

<div class="modal fade" id="eventScheduleModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title serif h3">Event Schedule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body schedule">
                @{
                    var groupedSchedule = Model.Steps.GroupBy(s => s.Day).OrderBy(g => g.Key).ToList();
                    var now = DateTime.Now;
                }

                @if (groupedSchedule.Any())
                {
                    <ul class="nav nav-tabs schedule-tabs" id="scheduleTabs" role="tablist">
                        @for (var i = 0; i < groupedSchedule.Count; i++)
                        {
                            var day = groupedSchedule[i];
                            var dayDate = Model.EventStartDate.AddDays(day.Key - 1);
                            var isActive = dayDate.Date == now.Date || (i == 0 && now.Date < Model.EventStartDate.Date);
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(isActive ? "active" : "") fs-5"
                                        id="day-tab-@day.Key"
                                        data-bs-toggle="tab" data-bs-target="#day-pane-@day.Key"
                                        type="button" role="tab">
                                    Day @day.Key
                                </button>
                            </li>
                        }
                    </ul>

                    <div class="tab-content" id="scheduleTabsContent">
                        @for (var i = 0; i < groupedSchedule.Count; i++)
                        {
                            var day = groupedSchedule[i];
                            var dayDate = Model.EventStartDate.AddDays(day.Key - 1);
                            var isToday = dayDate.Date == now.Date;
                            var isActivePane = isToday || (i == 0 && now.Date < Model.EventStartDate.Date);

                            <div class="tab-pane ps-2 fade @(isActivePane ? "show active" : "")"
                                 id="day-pane-@day.Key"
                                 role="tabpanel"
                                 aria-labelledby="day-tab-@day.Key"
                                 tabindex="0"
                                 data-date="@dayDate.ToString("yyyy-MM-dd")">
                                <div class="timeline">
                                    @{
                                        var steps = day.OrderBy(s => s.StartTime.Hour < 6 ? 1 : 0).ThenBy(s => s.StartTime).ToList();
                                    }
                                    @for (var j = 0; j < steps.Count; j++)
                                    {
                                        var step = steps[j];
                                        var nextStep = j < steps.Count - 1 ? steps[j + 1] : null;

                                        <div class="timeline-item"
                                             id="step-@step.Id"
                                             data-start="@step.StartTime.ToString("HH:mm")"
                                             data-end="@(step.EndTime?.ToString("HH:mm"))"
                                             data-next-start="@(nextStep?.StartTime.ToString("HH:mm"))">
                                            <div class="timeline-marker"></div>
                                            <div class="timeline-content d-flex align-items-baseline gap-2">
                                                <span class="badge text-white">
                                                    @step.StartTime.ToString("HH:mm")
                                                    @if (step.EndTime.HasValue)
                                                    {
                                                        @:- @step.EndTime.Value.ToString("HH:mm")
                                                    }
                                                </span>
                                                <div class="timeline-label">@step.Label</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">No schedule available.</p>
                }
            </div>
        </div>
    </div>
</div>
