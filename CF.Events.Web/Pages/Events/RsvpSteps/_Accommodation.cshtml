@using CF.Events.Web.Models
@model RsvpFormResponse

@{
    var existingAcc = Model.ExistingRsvp?.Accommodations ?? [];
    var existingPeople = Model.ExistingRsvp?.People ?? [];
    var hasAnyBooked = existingAcc.Any(a => a.HasBooked);
}

@if (!Model.ShowAccommodationOptions)
{
    <p class="text-muted">No accommodation options for this event.</p>
}
else
{
    <div id="accommodation-server">
        @if (!string.IsNullOrEmpty(Model.AccommodationLink))
        {
            <div class="alert alert-info mb-3">
                <i class="bi bi-link-45deg me-1"></i> <strong>Reservation link:</strong>
                <a href="@Model.AccommodationLink" target="_blank" rel="noopener">@Model.AccommodationLink</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.AssignedAccommodationCode))
        {
            <div class="alert alert-success mb-3">
                <i class="bi bi-key me-1"></i> Your reservation code: <strong>@Model.AssignedAccommodationCode</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.AccommodationInfo))
        {
            <div class="alert alert-secondary mb-3">@Model.AccommodationInfo</div>
        }

        <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" id="acc-has-booked" @(hasAnyBooked ? "checked" : "")>
            <label class="form-check-label" for="acc-has-booked">I have booked my accommodation</label>
        </div>
    </div>
}
