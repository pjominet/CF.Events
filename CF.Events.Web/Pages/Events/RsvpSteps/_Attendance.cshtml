@using CF.Events.Web.Models
@using CF.Events.Web.Pages.Events
@model RsvpFormResponse

@{
    var existingPeople = Model.ExistingRsvp?.People ?? [];
}

@for (var i = 0; i < Model.InvitedPersons.Count; i++)
{
    var person = Model.InvitedPersons[i];
    var existing = existingPeople.FirstOrDefault(p => p.InvitedPersonId == person.Id);
    var attending = existing?.Attending ?? true;

    <div class="person-card @(!attending ? "not-attending" : "")"
         data-person-idx="@i"
         data-invited-person-id="@person.Id"
         data-is-plus-one="false"
         data-is-primary="@person.IsPrimary.ToString().ToLower()"
         @if (existing?.Id > 0) { <text>data-person-id="@existing.Id"</text> }>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>@person.Name</strong>
                @if (person.IsPrimary)
                {
                    <span class="badge bg-info ms-2">Primary</span>
                }
                @if (person.IsUser)
                {
                    <span class="badge bg-success ms-2">You</span>
                }
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input attendance-toggle" type="checkbox"
                       id="person-attending-@i" @(attending ? "checked" : "")>
                <label class="form-check-label" for="person-attending-@i">Attending</label>
            </div>
        </div>
        <input type="hidden" id="person-name-@i" value="@person.Name">
        <input type="hidden" id="person-email-@i" value="@(person.Email ?? "")">
    </div>
}
