@page "/events/{eventId:int}/invitation"
@using CF.Events.Web.Infrastructure.Extensions
@model CF.Events.Web.Pages.Events.InvitationModel
@{
    Layout = "_NoNavLayout";
    ViewData["Title"] = Model.EventData?.Name ?? "Invitation";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/invitation.css" asp-append-version="true"/>
}

<section class="invite-page">
    @if (Model.NotFoundOrForbidden)
    {
        <div class="invite-error">
            <h1>Oops</h1>
            <p>Event not found or you are not invited.</p>
            <a href="/" class="invite-btn invite-btn-back d-inline-block">Back to Dashboard</a>
        </div>
    }
    else
    {
        <div class="book-container" id="bookContainer">
            <!-- Cover -->
            <div class="cover">
                <div class="cover-front">
                    <div class="cover-content">
                        <div class="my-auto">
                            <h1>
                                <span class="cursive">Patrick and Éadaoin invite</span>
                                <strong class="d-block my-2 fs-1 opacity-100 serif">@Model.GuestGroup!.Label</strong>
                                <span class="cursive">to celebrate their</span>
                            </h1>
                            <h2 class="serif"><strong>@Model.EventData!.Name</strong></h2>
                            <hr class="invite-divider"/>
                            <div class="cover-location">
                                <p class="cursive">
                                    Salt Hill
                                    <br/>
                                    Ireland
                                </p>
                            </div>
                        </div>
                        <div>
                            <button id="cover-button" class="btn-glass btn-glass-light text-white">
                                <i class="bi bi-stars"></i>
                                <span id="cover-button-text" class="mx-2">Click to open</span>
                                <i class="bi bi-stars"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="cover-back">
                    <!-- Back of the cover, empty or simple design -->
                </div>
            </div>

            <div class="right-page">
                <div class="page-content">
                    <h3>RSVP</h3>
                    <p>
                        <strong>Date:</strong>
                        <br/>
                        @Model.EventData.StartDate.ToLongDateString()
                        @if (Model.EventData.EndDate != Model.EventData.StartDate)
                        {
                            <br/>
                            @Model.EventData.EndDate.ToLongDateString()
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(Model.EventData.Location))
                    {
                        <p><strong>Location:</strong><br>@Model.EventData.Location</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.EventData.Description))
                    {
                        <div class="rsvp-description">
                            <jsonrenderer input="@Model.EventData.Description"/>
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Model.BackUrl" class="btn btn-secondary btn-animated rounded-5 px-4" id="returnButton">@(User.IsAdmin() ? "Back" : "Cancel")</a>
                        <a href="/events/@Model.EventData!.Id/rsvp" class="btn btn-primary btn-animated rounded-5 px-4">RSVP</a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@section Scripts
{
    <script src="~/js/invitation.js" type="text/javascript" asp-append-version="true"></script>
}
