@page "/events/{eventId:int}/{userId}/save-the-date"
@model CF.Events.Web.Pages.Events.SaveTheDate

@{
    Layout ="_NoNavLayout";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/invitation.css" asp-append-version="true"/>
}

<section class="invite-page">
    @if (Model.NotFoundOrForbidden)
    {
        <div class="alert alert-danger">
            <h1>Oops</h1>
            <p>Seems you are not authorized to see this.</p>
        </div>
    }
    else
    {
        <div class="invite-card">
            <div class="invite-content">
                <img src="@Model.ImageUrl" alt="Save the date - Wedding Patrick & Éadaoin" class="img-fluid invite-image">
            </div>
        </div>
    }
</section>
