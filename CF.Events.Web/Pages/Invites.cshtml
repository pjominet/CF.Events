@page "/invites"
@model CF.Events.Web.Pages.InvitesModel
@{
    ViewData["Title"] = "My Invitations";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="serif fs-1">My Invitations</h1>
            <p class="text-muted">Here are all the events you have been invited to.</p>
        </div>
    </div>

    @if (Model.MyInvites.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded-3">
            <i class="bi bi-envelope-open text-muted display-1 mb-3"></i>
            <h3>No invitations found</h3>
            <p class="text-muted">You haven't been invited to any events yet.</p>
        </div>
    }
    else
    {
        <div class="container-fluid p-0">
            <div id="invitesGrid"
                 class="row g-4 pb-4"
                 data-page-size="@InvitesModel.PageSize"
                 data-total-count="@Model.TotalCount"
                 data-load-url="/invites">
                @foreach (var invite in Model.MyInvites)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        @if (invite.HasRsvped)
                        {
                            <div class="card shadow-lg border-0 border-start border-3 @(invite.Attending ? "border-success" : "border-secondary")">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@invite.Event.Name</h5>
                                        @if (invite.Attending)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Attending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Not Attending</span>
                                        }
                                    </div>
                                    @if (invite.Attending && invite.ParticipantAttendance.Any())
                                    {
                                        <div class="mb-2">
                                            @foreach (var pa in invite.ParticipantAttendance.OrderBy(pa => pa.ParticipantName))
                                            {
                                                <div class="small mb-1">
                                                    <strong>@pa.ParticipantName</strong>:
                                                    @foreach (var day in pa.AttendingDays.OrderBy(d => d))
                                                    {
                                                        <span class="badge rounded-pill bg-light text-dark border px-2 py-1 ms-1">Day @day</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    <p class="card-text small text-muted mb-3">
                                        <i class="bi bi-calendar-event me-2"></i>@invite.Event.StartDate.ToShortDateString()
                                        @if (invite.Event.EndDate != invite.Event.StartDate)
                                        {
                                            <text> - @invite.Event.EndDate.ToShortDateString()</text>
                                        }
                                        <br/>
                                        <i class="bi bi-geo-alt me-2"></i>@invite.Event.Location
                                    </p>
                                    <hr class="text-muted opacity-25"/>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-primary flex-fill"
                                                data-event-id="@invite.Event.Id">
                                            <i class="bi bi-eye me-1"></i>View Details
                                        </button>
                                        <form method="post" action="/events/@invite.Event.Id/rsvp?handler=Cancel" class="flex-fill"
                                              data-confirm="Are you sure you want to cancel your RSVP?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                <i class="bi bi-x-lg me-1"></i>Cancel
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card shadow-lg border-0">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@invite.Event.Name</h5>
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                    </div>
                                    <p class="card-text small text-muted mb-3">
                                        <i class="bi bi-calendar-event me-2"></i>@invite.Event.StartDate.ToShortDateString()
                                        @if (invite.Event.EndDate != invite.Event.StartDate)
                                        {
                                            <text> - @invite.Event.EndDate.ToShortDateString()</text>
                                        }
                                        <br/>
                                        <i class="bi bi-geo-alt me-2"></i>@invite.Event.Location
                                    </p>
                                    <hr class="text-muted opacity-25"/>
                                    <p class="small text-muted mb-3">
                                        <i class="bi bi-info-circle me-1"></i>You have been invited to this event. Please review and respond.
                                    </p>
                                    <div class="d-grid">
                                        <a href="/events/@invite.Event.Id/invitation" class="btn btn-primary">
                                            <i class="bi bi-envelope-open me-2"></i>View Invitation & RSVP
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Loading indicator -->
                <div id="loadingSpinner" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div id="_rsvpDetailContainer"></div>

@section Scripts {
    <script src="/js/invites.js" type="text/javascript" asp-append-version="true"></script>
}
