@page
@model CF.Events.Web.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy & Security";
}

<div class="container-fluid pb-3">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm border-0 bg-light-subtle">
                <div class="card-body p-4 p-md-5">
                    <h1 class="display-5 mb-4 text-primary">
                        <i class="bi bi-shield-check me-2"></i>Privacy & Security
                    </h1>

                    <p class="lead mb-5">
                        We take your data protection and security seriously. This page outlines our commitments and the technical measures we take to ensure your information remains safe.
                    </p>

                    <section class="mb-5">
                        <h2 class="h4 mb-3 border-bottom pb-2">
                            <i class="bi bi-eye-slash me-2 text-info"></i>Data Protection
                        </h2>
                        <ul class="list-group list-group-flush bg-transparent">
                            <li class="list-group-item bg-transparent border-0 px-0">
                                <strong>Role Separation:</strong> We enforce strict Role-Based Access Control (RBAC). Guests can only access their invitations, while administrative features are restricted to verified administrators.
                            </li>
                            <li class="list-group-item bg-transparent border-0 px-0">
                                <strong>Browser Security:</strong> We use modern browser security headers (HSTS, CSP, X-Frame-Options, No-Referrer) to protect your session from cross-site scripting (XSS) and data leakage.
                            </li>
                            <li class="list-group-item bg-transparent border-0 px-0">
                                <strong>Minimal Data Retention:</strong> We only collect the information necessary to manage the events you are invited to. If an event gets removed, so does all your related information.
                            </li>
                            <li class="list-group-item bg-transparent border-0 px-0">
                                <strong>Private Infrastructure:</strong> Both our web application and database are hosted on privately owned hardware following modern security standards & encryption where possible to ensure complete control over your data with zero third party influence.
                            </li>
                        </ul>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 mb-3 border-bottom pb-2">
                            <i class="bi bi-journal-text me-2 text-info"></i>Audit & Transparency
                        </h2>
                        <p>
                            To ensure accountability and detect unauthorized access, we maintain a <strong>Security Audit Log</strong>. This log records:
                        </p>
                        <ul class="list-group list-group-flush bg-transparent mb-3 ms-3">
                            <li class="list-group-item bg-transparent border-0 px-0"> - Login attempts (timestamp and authentication method)</li>
                            <li class="list-group-item bg-transparent border-0 px-0"> - Unauthorized resource accesses</li>
                            <li class="list-group-item bg-transparent border-0 px-0"> - IP addresses and basic device information (User-Agent)</li>
                        </ul>
                        <p class="small text-muted italic">
                            These logs are strictly for security auditing and are accessible only to system administrators.
                        </p>
                    </section>

                    <section>
                        <h2 class="h4 mb-3 border-bottom pb-2">
                            <i class="bi bi-envelope-check me-2 text-info"></i>Communication
                        </h2>
                        <p>
                            We use email primarily for authentication and essential event updates. We do not sell your contact information to third parties or use it for unsolicited marketing.
                        </p>
                    </section>

                    <div class="mt-5 pt-4 text-center border-top">
                        <p class="text-muted small">
                            Last Updated: @DateTime.UtcNow.ToString("MMMM dd, yyyy")
                        </p>
                        <a asp-page="/Index" class="btn btn-outline-primary btn-sm mt-2">
                            Return Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
