@page "/admin/events"
@model CF.Events.Web.Pages.Admin.EventsModel
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active">Events</li>
                    </ol>
                </nav>
                <h1 class="cursive fs-1">Manage Events</h1>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEventModal">
                <i class="bi bi-calendar-plus me-2"></i>New Event
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Name</th>
                            <th>Date</th>
                            <th class="text-center">Design</th>
                            <th class="text-center">Active</th>
                            <th>Quick Invite</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ev in Model.AllEvents)
                    {
                        <tr>
                            <td class="fw-bold">@ev.Name<br /><small class="text-muted fw-normal">@ev.Type</small></td>
                            <td>@ev.Date.ToShortDateString()</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(ev.InvitationFileName))
                                {
                                    <span class="badge bg-primary">@ev.InvitationFileName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">None</span>
                                }
                            </td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@ev.Id" class="d-inline-block">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked="@ev.IsActive" onchange="this.form.submit()">
                                    </div>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Invite" asp-route-id="@ev.Id" class="input-group input-group-sm" style="max-width: 250px;">
                                    <input type="email" name="email" class="form-control" placeholder="guest@@email.com" required>
                                    <button class="btn btn-primary" type="submit" title="Invite to event">
                                        <i class="bi bi-person-plus"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a href="/events/@ev.Id/invitation" class="btn btn-outline-info btn-sm" title="Preview Invitation" target="_blank">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.AllEvents.Count == 0)
            {
                <div class="text-center py-4 text-muted">No events found. Create your first event.</div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="createEventModal" tabindex="-1" data-autoshow="@(Model.ShowCreateModal ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Name</label>
                        <input asp-for="NewEvent.Name" class="form-control" placeholder="Wedding" />
                        <span asp-validation-for="NewEvent.Name" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Type</label>
                            <select asp-for="NewEvent.Type" class="form-select">
                                <option value="Wedding">Wedding</option>
                                <option value="Engagement">Engagement</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Date</label>
                            <input asp-for="NewEvent.Date" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location</label>
                        <input asp-for="NewEvent.Location" class="form-control" placeholder="Grand Hall" />
                        <span asp-validation-for="NewEvent.Location" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Invitation Design</label>
                        <select asp-for="NewEvent.InvitationFileName" class="form-select">
                            <option value="">-- No custom design --</option>
                            @foreach (var file in Model.InvitationFiles)
                            {
                                <option value="@file">@file</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
