@page "/admin/events"
@using System.Text.Json
@model CF.Events.Web.Pages.Admin.EventsModel
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active">Events</li>
                    </ol>
                </nav>
                <h1 class="serif fs-1">Manage Events</h1>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editEventModal" id="newEventBtn">
                <i class="bi bi-calendar-plus me-2"></i>New Event
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="eventsTable">
                    <thead class="table-info sticky-top">
                    <tr>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Design</th>
                        <th>Accommodation Code</th>
                        <th>Invitees</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var eventData in Model.AllEvents)
                    {
                        <tr>
                            <td class="fw-bold">@eventData.Name</td>
                            <td>
                                @eventData.Date.ToShortDateString()
                                @if (eventData.EndDate > eventData.Date)
                                {
                                    <text> – @eventData.EndDate.ToShortDateString()</text>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(eventData.InvitationFileName))
                                {
                                    <span class="badge bg-primary">@(eventData.OriginalInvitationFileName ?? "Custom image")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">None</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(eventData.AccommodationCode))
                                {
                                    <span class="badge bg-primary">@(eventData.AccommodationCode)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">None</span>
                                }
                            </td>
                            <td>
                                <a href="/admin/events/@eventData.Id/invitees" class="badge bg-info text-decoration-none" title="Manage Invitees">
                                    @(Model.InviteeCounts.TryGetValue(eventData.Id, out var count) ? count : 0)
                                </a>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@eventData.Id" class="d-flex align-items-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked="@eventData.IsActive" onchange="this.form.submit()">
                                    </div>
                                </form>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-warning btn-sm" title="Edit Event"
                                            data-bs-toggle="modal" data-bs-target="#editEventModal"
                                            data-bs-event="@Model.GetSerializedEvent(eventData)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <a href="/events/@eventData.Id/invitation" class="btn btn-info btn-sm" title="Preview Invitation" data-bs-toggle="tooltip">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/admin/events/@eventData.Id/invitees" class="btn btn-primary btn-sm" title="Manage Invitees" data-bs-toggle="tooltip">
                                        <i class="bi bi-people"></i>
                                    </a>
                                    <a href="/admin/events/@eventData.Id/days" class="btn btn-outline-primary btn-sm" title="Manage Days" data-bs-toggle="tooltip">
                                        <i class="bi bi-calendar3"></i>
                                    </a>
                                    <a href="/admin/events/@eventData.Id/custom-questions" class="btn btn-outline-primary btn-sm" title="Custom Questions" data-bs-toggle="tooltip">
                                        <i class="bi bi-question-circle"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@eventData.Id"
                                          onsubmit="return confirm('Delete event &quot;@eventData.Name&quot; and all its invitations? This cannot be undone.');">
                                        <button type="submit" class="btn btn-danger btn-sm rounded-start-0 rounded-end-1" title="Delete Event" data-bs-toggle="tooltip">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.AllEvents.Count == 0)
            {
                <div class="text-center py-4 text-muted">No events found. Create your first event.</div>
            }
        </div>
    </div>
</div>

<partial name="Shared/_EditEventModal" model="Model.NewEvent"/>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/events.js" type="text/javascript" asp-append-version="true"></script>
}
