@page "/admin/users"
@using CF.Events.Web.Infrastructure.Extensions
@model CF.Events.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container container-stretch py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <section>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active">Users</li>
                    </ol>
                </nav>
                <h1 class="fs-1">@ViewData["Title"]</h1>
            </section>
            <section class="d-flex gap-2">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="bi bi-plus me-2"></i>Add User
                </button>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importUsersModal">
                    <i class="bi bi-upload me-2"></i>Import Users
                </button>
            </section>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-2">
            <div class="d-flex align-items-center justify-content-between flex-grow-1">
                <div class="d-flex gap-2 align-items-center">
                    <span class="text-muted me-2">Bulk actions:</span>
                    <button type="button" class="btn btn-danger btn-sm bulk-action-btn" disabled onclick="executeBulkAction('delete')">
                        <i class="bi bi-trash me-1"></i>Delete selected
                    </button>
                </div>
                <div class="flex-grow-1" style="max-width: 300px;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="userSearchInput" class="form-control" placeholder="Search users...">
                    </div>
                </div>
            </div>
            <form id="bulkActionForm" method="post" data-delete-url="@Url.Page("", "BulkDelete")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userIds" id="bulkActionUserIds" />
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div id="usersTableContainer" data-scroll-persist class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-success sticky-top">
                    <tr>
                        <th style="width: 40px;">
                            <input class="form-check-input" type="checkbox" id="selectAllUsers">
                        </th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Guest Group</th>
                        <th>Group Max People</th>
                        <th>Roles</th>
                        <th>Password Set?</th>
                        <th>Is Active</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.AllUsers)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input user-checkbox" type="checkbox" value="@user.Id" @(user.IsActive || (user.UserRoles.Contains(Roles.Sudo) && !User.IsSudo()) ? "disabled" : "")>
                            </td>
                            <td class="fw-bold">@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>@user.GuestGroup</td>
                            <td>@(user.MaxPeople == 0 ? "-" : user.MaxPeople)</td>
                            <td>
                                <div class="d-flex justify-content-start align-items-center gap-1">
                                    @foreach (var role in user.GetOrderedRoles(User.IsSudo()))
                                    {
                                        var badgeColor = role switch
                                        {
                                            Roles.Sudo => "bg-success",
                                            Roles.Admin => "bg-danger",
                                            Roles.User => "bg-secondary",
                                            Roles.Guest => "bg-info",
                                            _ => "bg-primary"
                                        };
                                        <span class="badge @badgeColor me-1">@role</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (user.MustChangePassword.HasValue)
                                {
                                    if (user.MustChangePassword.Value)
                                    {
                                        @:<i class="bi bi-x text-danger"></i>
                                    }
                                    else
                                    {
                                        @:<i class="bi bi-check text-success"></i>
                                    }
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-start align-items-center">
                                    <form method="post" asp-page-handler="Toggle" asp-route-userId="@user.Id"
                                          class="d-flex align-items-center justify-content-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input" type="checkbox" checked="@user.IsActive"
                                                   disabled="@(!User.IsAdmin() || User.GetId() == user.Id || (user.UserRoles.Contains(Roles.Sudo) && !User.IsSudo()))"
                                                   onchange="@(User.IsAdmin() && User.GetId() != user.Id && (!user.UserRoles.Contains(Roles.Sudo) || User.IsSudo()) ? "this.form.submit()" : string.Empty)">
                                        </div>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-start align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#addUserModal"
                                            data-user-id="@user.Id"
                                            data-user-displayname="@user.DisplayName"
                                            data-user-email="@user.Email"
                                            data-user-phone="@user.Phone"
                                            data-user-guestgroup="@user.GuestGroup"
                                            data-user-maxpeople="@user.MaxPeople"
                                            data-user-roles="@string.Join(",", user.UserRoles)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (User.IsAdmin() && User.GetId() != user.Id && !user.UserRoles.Contains(Roles.Guest))
                                    {
                                        if (!user.UserRoles.Contains(Roles.Admin))
                                        {
                                            <form method="post" asp-page-handler="Promote" asp-route-userId="@user.Id"
                                                  class="d-flex align-items-center justify-content-center">
                                                <button class="btn btn-sm btn-outline-success" type="submit"
                                                        data-bs-toggle="tooltip" data-bs-title="Promote to Admin">
                                                    <i class="bi bi-arrow-up-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (!user.UserRoles.Contains(Roles.Sudo) || User.IsSudo())
                                        {
                                            <form method="post" asp-page-handler="Demote" asp-route-userId="@user.Id"
                                                  class="d-flex align-items-center justify-content-center">
                                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                                        data-bs-toggle="tooltip" data-bs-title="Demote to User">
                                                    <i class="bi bi-arrow-down-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                    @if (User.IsAdmin() && User.GetId() != user.Id && !user.IsActive && (!user.UserRoles.Contains(Roles.Sudo) || User.IsSudo()))
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-userId="@user.Id"
                                              data-confirm="Delete user &quot;@user.DisplayName&quot;? This cannot be undone.">
                                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                                    data-bs-toggle="tooltip" data-bs-title="Delete User">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.AllUsers.Count == 0)
            {
                <div class="text-center py-4 text-muted">No users yet</div>
            }
        </div>
    </div>
</div>

<partial name="Shared/_AddUserModal" for="NewUser"/>
<partial name="Shared/_ImportUsersModal"/>

@section Scripts {
    <script src="/js/users.js" type="text/javascript" asp-append-version="true"></script>
}
