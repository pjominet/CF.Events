@page "/admin/users"
@using CF.Events.Web.Infrastructure.Extensions
@model CF.Events.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item active">Users</li>
                    </ol>
                </nav>
                <h1 class="cursive fs-1">Manage Users</h1>
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#inviteUserModal">
                <i class="bi bi-envelope-plus me-2"></i>Invite User
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                    <tr>
                        <th>Display Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.AllUsers)
                    {
                        <tr>
                            <td class="fw-bold">@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-info me-1">@role</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (User.IsAdmin() && User.GetId() != user.Id)
                                    {
                                        if (!user.Roles.Contains(Roles.Admin))
                                        {
                                            <form method="post" asp-page-handler="Promote" asp-route-userId="@user.Id"
                                                  class="d-flex align-items-center justify-content-center">
                                                <button class="btn btn-sm btn-outline-success" type="submit"
                                                        data-bs-toggle="tooltip" data-bs-title="Promote to Admin">
                                                    <i class="bi bi-arrow-up-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="Demote" asp-route-userId="@user.Id"
                                                  class="d-flex align-items-center justify-content-center">
                                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                                        data-bs-toggle="tooltip" data-bs-title="Demote to User">
                                                    <i class="bi bi-arrow-down-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <form method="post" asp-page-handler="Toggle" asp-route-userId="@user.Id"
                                              class="d-flex align-items-center justify-content-center">
                                            <div class="form-check form-switch d-inline-block">
                                                <input class="form-check-input" type="checkbox" checked="@user.IsActive" onchange="this.form.submit()">
                                            </div>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.AllUsers.Count == 0)
            {
                <div class="text-center py-4 text-muted">No users found.</div>
            }
        </div>
    </div>
</div>

@{
    ViewData["InviteModalShow"] = Model.ShowInviteModal;
    ViewData["InviteDisplayName"] = Model.Invite.DisplayName;
    ViewData["InviteEmail"] = Model.Invite.Email;
    ViewData["InvitePassword"] = Model.Invite.Password;
}
<partial name="_InviteUserModal"/>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
