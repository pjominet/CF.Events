@page "/admin/audit-log"
@model CF.Events.Web.Pages.Admin.AuditLogModel
@{
    ViewData["Title"] = "Security Audit Log";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                    <li class="breadcrumb-item active">Audit Log</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1>@ViewData["Title"]</h1>
                <button id="refreshAuditBtn" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div id="auditScrollContainer" data-scroll-persist class="table-responsive" style="max-height: 75vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-danger sticky-top">
                    <tr>
                        <th>Date & Time</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>IP Address</th>
                        <th>Method</th>
                        <th>User Agent</th>
                    </tr>
                    </thead>
                    <tbody id="auditTableBody">
                    @foreach (var audit in Model.Audits)
                    {
                        <tr>
                            <td class="text-nowrap">@audit.LoginAt.ToString("g")</td>
                            <td class="fw-bold">@audit.DisplayName</td>
                            <td>@audit.Email</td>
                            <td><code>@audit.IpAddress</code></td>
                            <td>
                                @{
                                    var methodBadge = audit.AuthMethod switch
                                    {
                                        "Password" => "bg-primary",
                                        "EmailToken" => "bg-info",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @methodBadge">@audit.AuthMethod</span>
                            </td>
                            <td class="small text-muted text-truncate" style="max-width: 250px;"
                                title="@audit.UserAgent" data-bs-toggle="tooltip" data-bs-placement="top">
                                @(audit.UserAgent.Length > 50 ? audit.UserAgent[..47] + "..." : audit.UserAgent)
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <div id="loadingIndicator" class="text-center py-3 d-none">
                    <div class="spinner-border spinner-border-sm text-danger" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            @if (Model.Audits.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                    No login activity recorded yet.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/audit-log.js" asp-append-version="true"></script>
}
