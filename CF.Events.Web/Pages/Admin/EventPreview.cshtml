@page "/admin/events/{id:int}/preview"
@model CF.Events.Web.Pages.Admin.EventPreviewModel
@{
    Layout = "_GlassLayout";
    ViewData["Title"] = $"Preview: {Model.Event.Name}";
    var eventId = Model.Event.Id;
}

@section Styles {
    <link rel="stylesheet" href="/css/invites.css" asp-append-version="true"/>
    <link rel="stylesheet" href="/css/timeline.css" asp-append-version="true"/>
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="d-flex justify-content-between mb-3 mx-auto" style="max-width: 650px;">
                <a asp-page="/Admin/EditEvent" asp-route-id="@eventId" class="btn btn-secondary shadow-sm rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to Editor
                </a>
                <button class="btn btn-info shadow-sm rounded-pill px-4" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>

            <div class="glass-card glass-card-lg mx-auto">
                <h2 class="mb-3 brand-name serif">@Model.Event.Name</h2>
                <div class="invite-header">
                    <div class="invite-details text-dark-glass">
                        <i class="bi bi-calendar-event me-2"></i>@Model.Event.StartDate.ToShortDateString()
                        @if (Model.Event.EndDate != Model.Event.StartDate)
                        {
                            @:- @Model.Event.EndDate.ToShortDateString()
                        }
                        <br/>
                        <i class="bi bi-geo-alt me-2"></i>@Model.Event.Location
                    </div>
                    <div class="invite-badge">
                        <span class="badge bg-info"><i class="bi bi-eye me-1"></i>Guest Preview</span>
                    </div>
                </div>

                <hr class="glass-divider">

                <div class="invite-action-grid">
                    <a href="/events/@eventId/invitation" class="btn-glass btn-glass-dark btn-100 d-flex align-items-center justify-content-center">
                        <strong><i class="bi bi-envelope-open me-2"></i>View Invitation</strong>
                    </a>

                    <a href="#" class="btn-glass btn-glass-dark btn-33 d-flex align-items-center justify-content-center disabled" style="cursor: not-allowed;">
                        <i class="bi bi-pencil-square me-2"></i>RSVP Now
                    </a>

                    <button type="button" class="btn-glass btn-glass-dark btn-66 d-flex align-items-center justify-content-center" data-event-id="@eventId" data-action="donations" data-target="eventDonationsModal">
                        <i class="bi bi-gift me-2"></i>Wedding Gifts
                    </button>

                    <button type="button" class="btn-glass btn-glass-dark btn-50 d-flex align-items-center justify-content-center" data-event-id="@eventId" data-action="accommodation" data-target="eventAccommodationModal">
                        <i class="bi bi-house me-2"></i>Accommodation Info
                    </button>

                    <button type="button" class="btn-glass btn-glass-dark btn-50 d-flex align-items-center justify-content-center" data-event-id="@eventId" data-action="travel" data-target="eventTravelModal">
                        <i class="bi bi-airplane me-2"></i>Travel Instructions
                    </button>

                    <button type="button" class="btn-glass btn-glass-dark btn-33 d-flex align-items-center justify-content-center" data-event-id="@eventId" data-action="faq" data-target="eventFaqModal">
                        <i class="bi bi-question-circle me-2"></i>FAQ
                    </button>

                    <button type="button" class="btn-glass btn-glass-dark btn-66 d-flex align-items-center justify-content-center" data-event-id="@eventId" data-action="schedule" data-target="eventScheduleModal">
                        <i class="bi bi-list-check me-2"></i>Event Schedule
                    </button>
                </div>
            </div>

            <div class="alert alert-info mt-4 border-info text-center">
                <i class="bi bi-info-circle me-2"></i>This is the preview mode. RSVP option is disabled, any other item can be previewed.
            </div>
        </div>
    </div>
</div>

<div id="_eventDetailContainer"></div>

@section Scripts {
    <script src="/js/invites.js" type="text/javascript" asp-append-version="true"></script>
}
