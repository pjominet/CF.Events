@page "/admin/events/{id:int}/invitees"
@using CF.Events.Web.Infrastructure.Extensions
@using CF.Events.Web.Models.Requests
@model CF.Events.Web.Pages.Admin.EventInviteesModel
@{
    ViewData["Title"] = "Manage Invitees";
}

<div class="container container-stretch py-4">
    <div class="row mb-3">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item"><a href="/admin/events">Events</a></li>
                        <li class="breadcrumb-item active">Invitees</li>
                    </ol>
                </nav>
                <h1 class="fs-1 mt-3">@Model.EventData.Name</h1>
                <p class="text-muted mb-0">@Model.EventData.StartDate.ToLongDateString()</p>
            </div>
            <div class="mt-auto mb-0">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAddGuests" aria-expanded="false" aria-controls="collapseAddGuests">
                        <i class="bi bi-plus-lg me-1"></i>Add Guests
                    </button>
                    <a href="@Url.Action("ExportInvitees", "AdminEvent", new { eventId = Model.EventData.Id })" class="btn btn-outline-success" id="exportExcelBtn">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export to Excel
                    </a>
                    <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="collapse" id="collapseAddGuests">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body px-3 py-2">
                <h5 class="card-title">Add guests to this event</h5>
                @if (Model.AvailableUsers.Count == 0)
                {
                    <p class="text-muted mb-0 small">All registered and available <strong>guests</strong> were already added. Use <a href="/admin/users">Invite New Person</a> to add someone new.</p>
                }
                else
                {
                    <form method="post" asp-action="InviteUsers" asp-controller="AdminEvent" asp-route-eventId="@Model.EventData.Id" onsubmit="showLoadingOverlay()">
                        @Html.AntiForgeryToken()
                        <section class="row mb-3">
                            <div class="col-12">
                                <select name="UserIds" asp-items="Model.AvailableUsers" class="form-select tom-select" required multiple placeholder="Select users to invite..."></select>
                                <input type="hidden" name="InviteCodeId" value="0"/>
                            </div>
                        </section>
                        <section class="row mb-2">
                            <div class="col-4">
                                <div class="flex-column gap-2">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="SendEmailsOnInvite" asp-for="NewInvite.SendEmailsOnInvite"
                                               id="noSendRadio" value="@SendEmailAction.NoSend"/>
                                        <label class="form-check-label" for="noSendRadio">
                                            Don't send invitation email yet
                                        </label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="SendEmailsOnInvite" asp-for="NewInvite.SendEmailsOnInvite"
                                               id="sendNowRadio" value="@SendEmailAction.Immediately"/>
                                        <label class="form-check-label" for="sendNowRadio">
                                            Immediately send invitation email on invite
                                        </label>
                                    </div>
                                    <div class="form-check d-flex align-items-center gap-2">
                                        <input class="form-check-input" type="radio" name="SendEmailsOnInvite" asp-for="NewInvite.SendEmailsOnInvite"
                                               id="scheduleRadio" value="@SendEmailAction.Scheduled"/>
                                        <label class="form-check-label mb-0" for="scheduleRadio">
                                            Schedule for:
                                        </label>
                                        <input type="datetime-local" name="ScheduledFor" asp-for="NewInvite.ScheduledFor"
                                               min="@DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm")"
                                               class="form-control form-control-sm w-auto"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="d-flex align-items-center gap-2">
                                    <label>Invite with accommodation code:</label>
                                    <input type="checkbox" name="AllowAccommodationCode" asp-for="NewInvite.AllowAccommodationCode" class="me-2"/>
                                </div>
                                <div class="mt-3">
                                    <select name="SelectedAccommodationCode" asp-for="NewInvite.SelectedAccommodationCode" asp-items="Model.GetAccommodationCodes()"
                                            disabled class="form-select form-select-sm tom-select w-100" data-placeholder="Select accommodation code"></select>
                                </div>
                            </div>
                        </section>
                        <div class="d-flex justifiy-content-center align-items-center">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-plus-lg me-1"></i>Invite to event
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center py-2">
            <div id="bulkActions">
                @if (Model.EventData.SaveDateTemplateId.HasValue(false))
                {
                    <button type="button" class="btn btn-primary btn-sm bulk-action-btn" disabled onclick="executeBulkAction('save-date')">
                        <i class="bi bi-calendar-check me-1"></i>Send Save the Date
                    </button>
                }
                @if (Model.EventData.InvitationTemplateId.HasValue(false))
                {
                    <button type="button" class="btn btn-info btn-sm bulk-action-btn" disabled onclick="executeBulkAction('resend')">
                        <i class="bi bi-send me-1"></i>Send invitations
                    </button>
                }
                <button type="button" class="btn btn-danger btn-sm bulk-action-btn" disabled onclick="executeBulkAction('remove')">
                    <i class="bi bi-x-lg me-1"></i>Remove selected
                </button>
                <form id="bulkActionForm" method="post"
                      data-resend-url="@Url.Action("SendInvites", "AdminEvent", new { eventId = Model.EventData.Id })"
                      data-remove-url="@Url.Action("RemoveInvitees", "AdminEvent", new { eventId = Model.EventData.Id })"
                      data-save-date-url="@Url.Action("SendSaveTheDates", "AdminEvent", new { eventId = Model.EventData.Id })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userIds" id="bulkActionUserIds"/>
                    <input type="hidden" name="actionType" id="bulkActionType"/>
                </form>
            </div>
            <div class="d-flex gap-4">
                <span class="invitee-status-filter user-select-none" data-status="" role="button" style="cursor: pointer;" title="Click reset any filters" data-bs-toggle="tooltip">
                    Current Invitee Count: <strong>@Model.Stats.Count (@Model.Stats.MaxPeopleSum)</strong>
                </span>
                <span class="invitee-status-filter user-select-none" data-status="attending" role="button" style="cursor: pointer;" title="Click to filter by Attending" data-bs-toggle="tooltip">
                    Attending: <strong class="text-success">@Model.Stats.Attending</strong>
                </span>
                <span class="invitee-status-filter user-select-none" data-status="declined" role="button" style="cursor: pointer;" title="Click to filter by Declined" data-bs-toggle="tooltip">
                    Declined: <strong class="text-danger">@Model.Stats.Declined</strong>
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="flex-grow-1" style="max-width: 300px;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="inviteeSearchInput" class="form-control" placeholder="Search invitees...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div id="inviteesTableContainer" data-scroll-persist data-event-id="@Model.EventData.Id" class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-success sticky-top">
                    <tr>
                        <th style="width: 40px;">
                            <input class="form-check-input" type="checkbox" id="selectAllInvitees">
                        </th>
                        <th>Display Name</th>
                        <th>Guest Group</th>
                        @if (Model.EventData.AccommodationCodes.Any())
                        {
                            <th>Assigned Accommodation Code</th>
                        }
                        <th>Invitation Priority</th>
                        <th class="text-center">Save Date Sent</th>
                        <th class="text-center">Invitation Sent</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var invitee in Model.Invitees)
                    {
                        <tr data-status="@invitee.Status.ToString().ToLower()" data-user-id="@invitee.UserId">
                            <td>
                                <input class="form-check-input invitee-checkbox" type="checkbox" value="@invitee.UserId">
                            </td>
                            <td>
                                <strong title="@invitee.Email" data-bs-toggle="tooltip">@invitee.DisplayName</strong>
                            </td>
                            <td>@invitee.GuestGroup</td>
                            @if (Model.EventData.AccommodationCodes.Any())
                            {
                                <td>
                                    <div class="w-100">
                                        <select class="form-select form-select-sm accommodation-select"
                                                data-user-id="@invitee.UserId"
                                                data-original-value="@invitee.AssignedAccommodationCode"
                                                asp-items="@Model.GetAccommodationCodes(invitee.AssignedAccommodationCode)">
                                        </select>
                                    </div>
                                </td>
                            }
                            <td>
                                <select class="form-select form-select-sm priority-select"
                                        data-user-id="@invitee.UserId"
                                        data-original-value="@invitee.InvitationPriority"
                                        data-bitwarden-no-fill="true"
                                        autocomplete="off">
                                    <option value="1" selected="@(invitee.InvitationPriority == 1)">1 - High</option>
                                    <option value="2" selected="@(invitee.InvitationPriority == 2)">2 - Medium</option>
                                    <option value="3" selected="@(invitee.InvitationPriority == 3)">3 - Low</option>
                                </select>
                            </td>
                            <td class="text-center">
                                @if (invitee.SaveTheDateSent.HasValue)
                                {
                                    <span class="text-success">@invitee.SaveTheDateSent.Value.ToString("g")</span>
                                }
                                else
                                {
                                    <i class="bi bi-minus text-muted"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (invitee.InvitationEmailSent.HasValue)
                                {
                                    <span class="text-success">@invitee.InvitationEmailSent.Value.ToString("g")</span>

                                }
                                else if (invitee.ScheduledFor != null)
                                {
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="badge bg-info"><i class="bi bi-calendar-event me-1"></i>Scheduled</span>
                                        <small class="text-muted mt-1" style="font-size: 0.75rem;">@invitee.ScheduledFor.Value.ToString("g")</small>
                                    </div>
                                }
                                else
                                {
                                    <i class="bi bi-minus text-muted"></i>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    var badge = invitee.Status switch
                                    {
                                        AttendanceStatus.Attending => "bg-success",
                                        AttendanceStatus.Declined => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badge">@invitee.Status.ToString()</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    @if (invitee.Status is AttendanceStatus.Attending)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                title="View RSVP Details" data-bs-toggle="tooltip"
                                                data-admin-rsvp-user-id="@invitee.UserId" data-admin-rsvp-event-id="@Model.EventData.Id"
                                                data-admin-rsvp-view-only="true">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    @if (Model.EventData.SaveDateTemplateId.HasValue(false) && invitee.Status is AttendanceStatus.Pending)
                                    {
                                        <form method="post" asp-action="SendSaveTheDate" asp-controller="AdminEvent" asp-route-eventId="@Model.EventData.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@invitee.UserId"/>
                                            <button class="btn btn-sm btn-primary" type="submit"
                                                    data-bs-toggle="tooltip" data-bs-title="Send Save the Date">
                                                <i class="bi bi-calendar-check"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (Model.EventData.InvitationTemplateId.HasValue(false) && invitee.Status is AttendanceStatus.Pending)
                                    {
                                        <form method="post" asp-action="SendInvite" asp-controller="AdminEvent" asp-route-eventId="@Model.EventData.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@invitee.UserId"/>
                                            <button type="submit" class="btn btn-info btn-sm" title="Send invite" data-bs-toggle="tooltip">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            title="RSVP on behalf" data-bs-toggle="tooltip"
                                            data-admin-rsvp-user-id="@invitee.UserId" data-admin-rsvp-event-id="@Model.EventData.Id">
                                        <i class="bi bi-person-check"></i>
                                    </button>
                                    <form method="post" asp-action="RemoveInvitee" asp-controller="AdminEvent" asp-route-eventId="@Model.EventData.Id" class="d-inline"
                                          data-confirm="Remove @invitee.DisplayName from this event?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@invitee.UserId"/>
                                        <button type="submit" class="btn btn-danger btn-sm" title="Remove invitee" data-bs-toggle="tooltip">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.Invitees.Count == 0)
            {
                <div class="text-center py-4 text-muted">No one is invited yet.</div>
            }
        </div>
    </div>
</div>

<div id="_rsvpResponsesContainer"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/rsvp.js" type="text/javascript" asp-append-version="true"></script>
    <script src="/js/invitees.js" type="text/javascript" asp-append-version="true"></script>
}
