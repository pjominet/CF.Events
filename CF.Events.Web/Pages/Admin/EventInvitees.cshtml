@page "/admin/events/{id:int}/invitees"
@model CF.Events.Web.Pages.Admin.EventInviteesModel
@{
    ViewData["Title"] = "Manage Invitees";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                        <li class="breadcrumb-item"><a href="/admin/events">Events</a></li>
                        <li class="breadcrumb-item active">Invitees</li>
                    </ol>
                </nav>
                <h1 class="serif fs-1 mt-3">@Model.EventData?.Name</h1>
                <p class="text-muted mb-0">@Model.EventData?.Date.ToLongDateString()</p>
            </div>
            <div class="d-flex mt-auto mb-0">
                <button type="button" class="btn btn-outline-primary" title="Regenerate Code"
                        data-bs-toggle="modal" data-bs-target="#regenerateCodeModal"
                        data-bs-event-id="@Model.EventData!.Id" data-bs-event-name="@Model.EventData!.Name">
                    <i class="bi bi-key-fill me-1"></i>Generate invite code
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title">Invite users</h5>
            @if (Model.AvailableUsers.Count == 0)
            {
                <p class="text-muted mb-0">All registered users are already invited. Use "Invite New Person" to add someone new.</p>
            }
            else
            {
                <form method="post" action="/events/@Model.EventData!.Id/invite-users" class="row g-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="inviteCode" value="@Model.CurrentInviteCodes"/>
                    <div class="col-12 mb-3">
                        <select name="UserIds" asp-items="Model.AvailableUsers" class="form-select tom-select" required multiple placeholder="Select users to invite..."></select>
                    </div>
                    <div class="col-9 row">
                        <div class="col-6 flex-column gap-2">
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" asp-for="SendEmailsOnInvite" id="sendNowRadio" value="true"/>
                                <label class="form-check-label" for="sendNowRadio">
                                    Immediately send email on invite
                                </label>
                            </div>
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input" type="radio" asp-for="SendEmailsOnInvite" id="scheduleRadio" value="false"/>
                                <label class="form-check-label mb-0" for="scheduleRadio">
                                    Schedule for:
                                </label>
                                <input type="datetime-local" asp-for="ScheduledFor" class="form-control form-control-sm w-auto"/>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.EventData?.AccommodationCode))
                        {
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <label class="form-check-label text-nowrap mb-0" for="scheduleRadio">
                                        Use Code:
                                    </label>
                                    <select name="InviteCode" class="form-select tom-select form-select-sm w-100" required>
                                        <option value=""></option>
                                        @foreach (var (inviteCode, validUntil) in Model.CurrentInviteCodes)
                                        {
                                            var validDays = (int)Math.Round((validUntil - DateTime.UtcNow).TotalDays);
                                            <option value="@inviteCode">@inviteCode (valid @validDays days)</option>
                                        }
                                    </select>
                                </div>
                                <input type="checkbox" asp-for="AllowUseOfAccommodationCode" class="me-2"/>Allow using accommodation code: <span class="alert alert-info p-1">@Model.EventData!.AccommodationCode</span>
                            </div>
                        }
                    </div>
                    <div class="col-3 mt-0">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-lg me-1"></i>Invite to event
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-success sticky-top">
                    <tr>
                        <th>Display Name</th>
                        <th>Email</th>
                        <th>Assigned Accommodation Code</th>
                        <th class="text-center">Email Sent</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var invitee in Model.Invitees)
                    {
                        <tr>
                            <td class="fw-bold">@invitee.DisplayName</td>
                            <td>@invitee.Email</td>
                            <td>
                                <div class="badge bg-info p-1">@invitee.AssignedAccommodationCode</div>
                            </td>
                            <td class="text-center">
                                @if (invitee.InvitationEmailSent)
                                {
                                    <span class="badge bg-success" title="Invitation email sent"><i class="bi bi-check-circle me-1"></i>Sent</span>
                                }
                                else if (invitee.ScheduledFor != null)
                                {
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="badge bg-info" title="Scheduled to be sent"><i class="bi bi-calendar-event me-1"></i>Scheduled</span>
                                        <small class="text-muted mt-1" style="font-size: 0.75rem;">@invitee.ScheduledFor.Value.ToString("g")</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark" title="Email not yet sent"><i class="bi bi-clock me-1"></i>Pending</span>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    var badge = invitee.Status switch
                                    {
                                        "Attending" => "bg-success",
                                        "Declined" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badge">@invitee.Status</span>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-action="ResendInvite" asp-controller="Event" asp-route-eventId="@Model.EventData!.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@invitee.UserId"/>
                                    <input type="hidden" name="inviteCode" value="@Model.CurrentInviteCodes"/>
                                    <button type="submit" class="btn btn-info btn-sm" title="Resend invite" data-bs-toggle="tooltip">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Remove" asp-route-id="@Model.EventData!.Id" class="d-inline"
                                      onsubmit="return confirm('Remove @invitee.DisplayName from this event?');">
                                    <input type="hidden" name="userId" value="@invitee.UserId"/>
                                    <button type="submit" class="btn btn-danger btn-sm" title="Remove invitee" data-bs-toggle="tooltip">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.Invitees.Count == 0)
            {
                <div class="text-center py-4 text-muted">No one is invited yet.</div>
            }
        </div>
    </div>
</div>

<partial name="Shared/_RegenerateCodeModal"/>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="/js/invitees.js" type="text/javascript" asp-append-version="true"></script>
}
