@model Event

<div class="modal fade" id="setInviteValidityModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Invite Validity</h5>
            </div>
            <form method="post" asp-page-handler="SetInviteValidity">
                <div class="modal-body">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label for="validDaysSelect" class="form-label">Valid for</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="validDaysSelect" asp-for="InviteValidity" step="1" min="1" max="365">
                            <span class="input-group-text">days</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Set</button>
                </div>
            </form>
        </div>
    </div>
</div>
