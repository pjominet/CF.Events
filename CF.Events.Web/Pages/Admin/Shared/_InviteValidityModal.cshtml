<div class="modal fade" id="setInviteValidityModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Invite Validity</h5>
            </div>
            <form method="post">
                <div class="modal-body">
                    <input type="hidden" name="validDays" id="modalValidDays" value="7" />
                    <div class="mb-3">
                        <label for="validDaysSelect" class="form-label">Valid for (days)</label>
                        <input type="number" class="form-control" id="validDaysSelect" name="validDays" min="1" max="365" value="30">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Set</button>
                </div>
            </form>
        </div>
    </div>
</div>
