<div class="modal fade" id="inviteeNotesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-static">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-chat-left-text me-2"></i>Notes for <span id="notesInvitee"></span>
                </h5>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="notesText" class="form-label fw-semibold">Notes</label>
                    <textarea class="form-control" id="notesText" rows="7" maxlength="1000" placeholder="Add notes..." style="white-space: pre-wrap;"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" data-bs-dismiss="modal" id="notesSaveBtn">Save</button>
            </div>
        </div>
    </div>
</div>
