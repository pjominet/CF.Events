<div class="modal fade" id="regenerateCodeModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="regenerateCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="regenerateCodeModalLabel">Regenerate Invite Code</h5>
            </div>
            <form method="post" id="regenerateCodeForm" action="">
                <div class="modal-body">
                    <input type="hidden" name="validDays" id="modalValidDays" value="7" />
                    <div class="mb-3">
                        <label for="validDaysSelect" class="form-label">Valid for (days)</label>
                        <select class="form-select" id="validDaysSelect" onchange="document.getElementById('modalValidDays').value = this.value">
                            <option value="1">1 Day</option>
                            <option value="3">3 Days</option>
                            <option value="7" selected>7 Days</option>
                            <option value="14">14 Days</option>
                            <option value="30">30 Days</option>
                            <option value="90">90 Days</option>
                            <option value="365">1 Year</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="labelInput" class="form-label">Label (optional)</label>
                        <input type="text" class="form-control" id="labelInput" name="label" placeholder="e.g. SUMMER2024" maxlength="100">
                        <div class="form-text">If left blank, a default label will be generated based on the event name and year.</div>
                    </div>
                    <p class="text-muted small">
                        Generating a new code will not invalidate existing codes immediately, but this will become the primary code for new invitations.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Regenerate</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('regenerateCodeModal');
        if (modal) {
            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const eventId = button.getAttribute('data-bs-event-id');
                const eventName = button.getAttribute('data-bs-event-name');

                const form = modal.querySelector('#regenerateCodeForm');
                const modalTitle = modal.querySelector('.modal-title');

                form.action = `/events/${eventId}/regenerate-code`;
                if (eventName) {
                    modalTitle.textContent = `Regenerate Invite Code for ${eventName}`;
                } else {
                    modalTitle.textContent = 'Regenerate Invite Code';
                }
            });
        }
    });
</script>
