@model EditEventModel.EventModel

<input type="hidden" asp-for="Id" data-upload-id="@Model.UploadSessionId"/>

<ul class="nav nav-tabs" id="eventEditorTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab" aria-controls="basic" aria-selected="true">Basic Info</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="travel-accommodation-tab" data-bs-toggle="tab" data-bs-target="#travel-accommodation" type="button" role="tab" aria-controls="travel-accommodation" aria-selected="false">Travel & Accommodation</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="donation-tab" data-bs-toggle="tab" data-bs-target="#donation" type="button" role="tab" aria-controls="donation" aria-selected="false">Gifts & Donations</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab" aria-controls="schedule" aria-selected="false">Schedule</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="faq-tab" data-bs-toggle="tab" data-bs-target="#faq" type="button" role="tab" aria-controls="faq" aria-selected="false">FAQ</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="technical-tab" data-bs-toggle="tab" data-bs-target="#technical" type="button" role="tab" aria-controls="technical" aria-selected="false">Technical</button>
    </li>
</ul>

<div class="tab-content" id="eventEditorTabsContent">
    <!-- Basic Info Tab -->
    <div class="tab-pane fade show active" id="basic" role="tabpanel" aria-labelledby="basic-tab">
        <div class="row">
            <div class="col-12 col-md-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Event Name</label>
                    <input asp-for="Name" type="text" class="form-control" placeholder="Wedding"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-bold">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control"/>
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-bold">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" min="@Model.StartDate.ToString("yyyy-MM-dd")"/>
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div id="schedule-warning" class="alert alert-danger fade show d-none" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    The event duration has been shortened. Schedule steps on days beyond the new end date will be removed.
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Location</label>
                    <input asp-for="Location" type="text" class="form-control" placeholder="Grand Hotel"/>
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control rte-editor visually-hidden" placeholder="Begin writing or select other block type..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Travel & Accommodation Tab -->
    <div class="tab-pane fade" id="travel-accommodation" role="tabpanel" aria-labelledby="travel-accommodation-tab">
        <div class="row">
            <div class="col-12 col-md-5">
                <div class="mb-3">
                    <label class="form-label fw-bold">Travel Instructions</label>
                    <textarea asp-for="TravelInstructions" class="form-control rte-editor visually-hidden" placeholder="Begin writing or select other block type..."></textarea>
                    <span asp-validation-for="TravelInstructions" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-7">
                <div class="mb-3">
                    <label class="form-label fw-bold">Accommodation Details</label>
                    <textarea asp-for="AccommodationDetails" class="form-control" rows="3" data-max-length="500" data-counter-id="accommodationCounter"></textarea>
                    <div class="d-flex justify-content-between mt-2">
                        <div class="form-text">Descriptive text explaining on how to book accommodation.</div>
                        <small id="accommodationCounter" class="text-muted"></small>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Booking Links</label>
                    <input asp-for="BookingLinks" value="@string.Join(", ", Model.BookingLinks)" class="form-control tag-select" autocomplete="off" placeholder="Add booking links..."/>
                    <div class="form-text">Supports phone numbers, emails, and web links</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Accommodation/Booking Codes</label>
                    <input asp-for="AccommodationCodes" value="@string.Join(", ", Model.AccommodationCodes)" class="form-control tag-select" autocomplete="off" data-placeholder="Add codes..."/>
                </div>
            </div>
        </div>
    </div>

    <!-- Donations Tab -->
    <div class="tab-pane fade" id="donation" role="tabpanel" aria-labelledby="donation-tab">
        <div class="mb-3">
            <label class="form-label fw-bold">Available Types</label>
            <div class="d-flex gap-3 mt-2">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Event.DonationTypes" id="donationTypeIban" value="@EditEventModel.DonationType.Iban" @(Model.DonationTypes.Contains(EditEventModel.DonationType.Iban) ? "checked" : "")>
                    <label class="form-check-label" for="donationTypeIban">IBAN</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Event.DonationTypes" id="donationTypeLink" value="@EditEventModel.DonationType.Link" @(Model.DonationTypes.Contains(EditEventModel.DonationType.Link) ? "checked" : "")>
                    <label class="form-check-label" for="donationTypeLink">Link</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Event.DonationTypes" id="donationTypePhysical" value="@EditEventModel.DonationType.Physical" @(Model.DonationTypes.Contains(EditEventModel.DonationType.Physical) ? "checked" : "")>
                    <label class="form-check-label" for="donationTypePhysical">Physical</label>
                </div>
            </div>
        </div>

        <div id="donationIbanWrapper" style="display: @(Model.DonationTypes.Contains(EditEventModel.DonationType.Iban) ? "block" : "none")" class="mb-3">
            <label class="form-label fw-bold">Donation IBAN</label>
            <input asp-for="DonationIban" type="text" class="form-control" data-max-length="64" data-counter-id="ibanCounter"/>
            <div class="d-flex justify-content-between mt-2">
                <div class="form-text">If set, the event will be eligible for donations via direct transfers.</div>
                <small id="ibanCounter" class="text-muted"></small>
            </div>
        </div>

        <div id="donationLinkWrapper" style="display: @(Model.DonationTypes.Contains(EditEventModel.DonationType.Link) ? "block" : "none")" class="mb-3">
            <label class="form-label fw-bold">Service Link</label>
            <input asp-for="DonationLink" type="text" class="form-control" data-max-length="250" data-counter-id="linkCounter"/>
            <div class="d-flex justify-content-between mt-2">
                <div class="form-text">If set, the event will be eligible for donations via an external service.</div>
                <small id="linkCounter" class="text-muted"></small>
            </div>
        </div>

        <div id="donationPhysicalWrapper" style="display: @(Model.DonationTypes.Contains(EditEventModel.DonationType.Physical) ? "block" : "none")" class="mb-3">
            <label class="form-label fw-bold">Physical Gift Info</label>
            <textarea asp-for="PhysicalGiftInfo" class="form-control" rows="3" data-max-length="1000" data-counter-id="giftCounter"></textarea>
            <div class="d-flex justify-content-between mt-2">
                <div class="form-text">Description of how physical gifts should be handled.</div>
                <small id="giftCounter" class="text-muted"></small>
            </div>
        </div>
    </div>

    <!-- Schedule Tab -->
    <div class="tab-pane fade" id="schedule" role="tabpanel" aria-labelledby="schedule-tab">
        <label class="form-label fw-bold">Event Schedule</label>
        <div id="schedule-container" data-max-days="@Model.MaxEventDays()">
            @for (var i = 0; i < Model.ScheduleSteps.Count; i++)
            {
                <div class="row gx-2 mb-2 schedule-row">
                    <div class="col-md-2">
                        <div class="input-group">
                            <span class="input-group-text">Day</span>
                            <input asp-for="ScheduleSteps[i].Day" type="number" class="form-control" placeholder="Day" value="@(Model.ScheduleSteps[i].Day == 0 ? 1 : Model.ScheduleSteps[i].Day)" min="1" max="@Model.MaxEventDays()" step="1"/>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <input asp-for="ScheduleSteps[i].TimeStamp" type="time" class="form-control"/>
                    </div>
                    <div class="col-md-6">
                        <input asp-for="ScheduleSteps[i].Label" type="text" class="form-control" placeholder="Label"/>
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-link text-danger remove-row"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
            }
            <hr/>
        </div>
        <div class="d-flex justify-content-center">
            <button type="button" class="btn btn-sm btn-success mt-1" id="add-schedule">Add Step</button>
        </div>
    </div>

    <!-- FAQ Tab -->
    <div class="tab-pane fade" id="faq" role="tabpanel" aria-labelledby="faq-tab">
        <label class="form-label fw-bold">Event FAQ</label>
    <div id="faq-container">
        @for (var i = 0; i < Model.FaqItems.Count; i++)
        {
            <div class="row gx-2 faq-row align-items-center">
                <div class="col-auto">
                    <i class="bi bi-list faq-handle" style="cursor: grab;"></i>
                </div>
                <div class="col">
                    <div class="mb-2">
                        <input asp-for="FaqItems[i].Question" type="text" class="form-control" placeholder="Question"/>
                    </div>
                    <div class="mb-2">
                        <textarea asp-for="FaqItems[i].Answer" class="form-control" placeholder="Answer" data-max-length="1000" data-counter-id="faq-c-@i"></textarea>
                        <div class="d-flex justify-content-end mt-2">
                            <small id="faq-c-@i" class="text-muted"></small>
                        </div>
                    </div>
                    <input type="hidden" asp-for="FaqItems[i].SortOrder" class="faq-sort-order" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-link text-danger remove-row"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
        }
    </div>
        <div class="d-flex justify-content-center">
            <button type="button" class="btn btn-sm btn-success mt-1" id="add-faq">Add Item</button>
        </div>
    </div>

    <!-- Technical Tab -->
    <div class="tab-pane fade" id="technical" role="tabpanel" aria-labelledby="technical-tab">
        <div class="row">
            <div class="col-12">
                <div class="mb-3">
                    <label class="form-label fw-bold"><i>Save the Date</i> Email Template ID</label>
                    <input asp-for="SaveDateEmailTemplateId" type="text" class="form-control"/>
                    <div class="form-text">If set, the event will be eligible for 'Save the Date' emails using this template.</div>
                </div>
                <div class="mb-3">
                    <div class="form-check mt-2">
                        <input asp-for="SendWithLink" class="form-check-input" type="checkbox">
                        <label class="form-check-label">Send <i>Save the Date</i> email with link instead of embedded image</label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold"><i>Invitation Email</i> Template ID</label>
                    <input asp-for="InvitationEmailTemplateId" type="text" class="form-control"/>
                    <div class="form-text">If set, the event will be eligible for 'Invite' emails using this template.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Max Participants per RSVP</label>
                    <input asp-for="MaxParticipantsPerRsvp" type="number" class="form-control" min="1" max="10"/>
                    <div class="form-text">The fallback maximum number of people that can be added to a single RSVP, in case the guest group does not set a value.</div>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsFinalised" class="form-check-input" type="checkbox" id="eventFinal">
                        <label class="form-check-label fw-bold" for="eventFinal">Is Finalised?</label>
                    </div>
                    <div class="form-text">Check this if you are sure that the event information will not drastically change anymore. Otherwise the guest will get a warning that any information can still be subject of change.</div>
                </div>
            </div>
        </div>
    </div>
</div>

