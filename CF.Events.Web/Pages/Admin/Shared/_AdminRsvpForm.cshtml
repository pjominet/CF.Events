@using CF.Events.Web.Pages.Events
@model (int MaxParticipants, int EventDuration, string UserId, RsvpModel.InputModel NewRsvp)

<div class="modal fade" id="adminRsvpModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="adminRsvpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adminRsvpModalLabel">RSVP on behalf of guest</h5>
            </div>
            <form method="post" asp-page-handler="AdminRsvp" id="adminRsvpForm">
                <input type="hidden" name="userId" value="@Model.UserId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label d-block">Will they be attending?</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="NewRsvp.Attending" id="adminAccept" value="true" @(Model.NewRsvp.Attending ? "checked" : "")>
                            <label class="form-check-label" for="adminAccept">Attending</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="NewRsvp.Attending" id="adminDecline" value="false" @(!Model.NewRsvp.Attending ? "checked" : "")>
                            <label class="form-check-label" for="adminDecline">Declined</label>
                        </div>
                    </div>

                    <div id="admin-attending-fields" class="@(Model.NewRsvp.Attending ? "" : "d-none")">
                        <partial name="~/Pages/Events/Shared/_RsvpParticipants.cshtml" model="(Model.NewRsvp.Participants, Model.MaxParticipants)" />

                        <h6 class="border-bottom pb-1 mb-3">Attendance Schedule</h6>
                        <partial name="~/Pages/Events/Shared/_RsvpAttendanceSchedule.cshtml" model="(Model.EventDuration, Model.NewRsvp.Participants, Model.NewRsvp.ParticipantsAttendance)" />

                        <h6 class="border-bottom pb-1 mb-3 mt-4">Dietary Requirements</h6>
                        <partial name="~/Pages/Events/Shared/_RsvpDietaryOptions.cshtml" model="(Model.NewRsvp.Participants, Model.NewRsvp.ParticipantsDiets)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save RSVP</button>
                </div>
            </form>
        </div>
    </div>
</div>
