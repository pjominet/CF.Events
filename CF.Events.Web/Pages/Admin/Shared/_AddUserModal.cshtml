@model UsersModel.InputModel
@{
    var show = ViewData[ViewDataKeys.ShowAddModal] as bool? ?? false;
}
<div class="modal fade" id="addUserModal" data-bs-backdrop="static" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header">
                    <h5 class="modal-title">Invite New User</h5>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" placeholder="John Doe" required />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="user@@example.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3 d-none" id="guestGroupContainer">
                        <label class="form-label fw-bold">Guest Group</label>
                        <input asp-for="GuestGroup" id="guestGroupInput" class="form-control" placeholder="Family Doe" />
                        <span asp-validation-for="GuestGroup" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Roles</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="NewUser.SelectedRoles" value="@Roles.User" id="roleUser">
                                <label class="form-check-label" for="roleUser">@Roles.User</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="NewUser.SelectedRoles" value="@Roles.Guest" id="roleGuest" checked>
                                <label class="form-check-label" for="roleGuest">@Roles.Guest</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
