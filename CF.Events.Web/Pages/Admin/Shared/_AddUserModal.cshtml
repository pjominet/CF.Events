@model UsersModel.InputModel
@{
    var show = ViewData[ViewDataKeys.ShowAddModal] as bool? ?? false;
}
<div class="modal fade" id="addUserModal" data-bs-backdrop="static" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add">
                <div class="modal-header">
                    <h5 class="modal-title">Invite New User</h5>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Display Name</label>
                        <input asp-for="DisplayName" value="@Model.DisplayName" class="form-control" placeholder="John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" value="@Model.Email" class="form-control" placeholder="user@@example.com" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
