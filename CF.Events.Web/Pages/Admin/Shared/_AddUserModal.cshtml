@model UsersModel.InputModel
@{
    var show = ViewData[ViewDataKeys.ShowAddModal] as bool? ?? false;
}
<div class="modal fade" id="addUserModal" data-bs-backdrop="static" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Add" id="addUserForm">
                <input type="hidden" asp-for="Id" id="userEditId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalTitle">Invite New User</h5>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Display Name</label>
                        <input asp-for="DisplayName" id="userDisplayName" class="form-control" placeholder="John Doe" required />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" id="userEmail" type="email" class="form-control" placeholder="user@@example.com" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" id="userPhone" class="form-control" placeholder="+123456789" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div id="guestGroupContainer" class="d-none">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Guest Group</label>
                                <input asp-for="GuestGroup" id="guestGroupInput" class="form-control" placeholder="Family Doe" />
                                <span asp-validation-for="GuestGroup" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Max People</label>
                                <input asp-for="MaxPeople" id="maxPeopleInput" type="number" class="form-control" min="1" value="4" />
                                <span asp-validation-for="MaxPeople" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Roles</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input role-radio" type="radio" asp-for="SelectedRoles" value="@Roles.User" id="roleUser">
                                <label class="form-check-label" for="roleUser">@Roles.User</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input role-radio" type="radio" asp-for="SelectedRoles" value="@Roles.Guest" id="roleGuest" checked>
                                <label class="form-check-label" for="roleGuest">@Roles.Guest</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="addUserSubmitBtn">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>
