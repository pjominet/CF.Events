@model EventsModel.InputModel
@{
    var show = ViewData[ViewDataKeys.ShowEventModal] as bool? ?? false;
}
<div class="modal fade" id="editEventModal" data-bs-backdrop="static" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div class="modal-header">
                    <h5 class="modal-title">@(Model.Id == 0 ? "Create New Event" : $"Edit Event {Model.Id}")</h5>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold">Event Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Wedding" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-bold">Start Date</label>
                            <input asp-for="StartDate" type="date" min="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-bold">End Date</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" placeholder="Optional Description" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Invitation Image</label>
                        <input asp-for="InvitationImage" type="file" accept="image/*" class="form-control" />
                        <span asp-validation-for="InvitationImage" class="text-danger"></span>
                        <div id="currentInvitationImageWrapper" class="mt-1" style="display: none;">
                            <small class="text-muted">Current file: <span id="currentInvitationImageName" class="fw-bold"></span></small>
                        </div>
                        <div class="form-text">Portrait images work best. Larger images are cropped to portrait for the invite card.</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="Grand Hotel" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6" id="accommodationCodeWrapper">
                            <label class="form-label fw-bold">Accommodation Codes</label>
                            <input name="AccommodationCodes" value="" class="form-control tag-select" autocomplete="off" data-placeholder="Add codes..."/>
                        </div>
                        <div class="col-12 my-3">
                            <label class="form-label fw-bold">Accommodation Details</label>
                            <textarea asp-for="AccommodationDetails" class="form-control" placeholder="Accommodation Details" rows="3"></textarea>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Save the Date Template ID</label>
                            <input asp-for="SaveDateEmailTemplateId" class="form-control" placeholder="12345" />
                            <div class="form-text">If set, the event will be eligible for 'Save the Date' emails using this template.</div>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Save the Date Template ID</label>
                            <input asp-for="InvitationEmailTemplateId" class="form-control" placeholder="56789" />
                            <div class="form-text">If set, the event will be eligible for 'Invite' emails using this template.</div>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">Booking Links</label>
                            <input name="BookingLinks" value="" class="form-control tag-select" autocomplete="off" placeholder="Add booking links..."/>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Save the Date Template ID</label>
                            <input asp-for="DonationIban" class="form-control" placeholder="56789" />
                            <div class="form-text">If set, the event will be eligible for 'Invite' emails using this template.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">@(Model.Id == 0 ? "Create Event" : "Save Changes")</button>
                </div>
            </form>
        </div>
    </div>
</div>
