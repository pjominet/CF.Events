@model EventsModel.InputModel
@{
    var show = ViewData[ViewDataKeys.ShowEventModal] as bool? ?? false;
}
<div class="modal fade" id="createEventModal" data-bs-backdrop="static" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Event</h5>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Wedding" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Date</label>
                        <input asp-for="Date" type="date" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="Grand Hall" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" placeholder="Optional Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Invitation Image</label>
                        <input asp-for="InvitationImage" type="file" accept="image/*" class="form-control" />
                        <span asp-validation-for="InvitationImage" class="text-danger"></span>
                        <div class="form-text">Portrait images work best. Larger images are cropped to portrait for the invite card.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Create Event</button>
                </div>
            </form>
        </div>
    </div>
</div>
