@page "/admin"
@model CF.Events.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="serif fs-1">@ViewData["Title"]</h1>
            <p class="text-muted">Welcome to the administration area. Choose a category to manage.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center p-4">
                    <div class="display-4 text-primary mb-3"><i class="bi bi-people"></i></div>
                    <h5 class="card-title">Users</h5>
                    <p class="card-text text-muted">Invite new guests and manage user accounts.</p>
                    <a href="/admin/users" class="btn btn-primary w-100 mt-auto">Manage Users</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column  text-center p-4">
                    <div class="display-4 text-info mb-3"><i class="bi bi-calendar-event"></i></div>
                    <h5 class="card-title">Events</h5>
                    <p class="card-text text-muted">Create events, manage designs, and invite guests to specific events.</p>
                    <a href="/admin/events" class="btn btn-info w-100 mt-auto">Manage Events</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
        </div>
    </div>
</div>
