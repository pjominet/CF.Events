@{
    var show = ViewData["AddUserModalShow"] as bool? ?? false;
    var displayName = ViewData["UserDisplayName"] as string ?? "";
    var email = ViewData["UserEmail"] as string ?? "";
}
<div class="modal fade" id="addUserModal" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Invite">
                <div class="modal-header">
                    <h5 class="modal-title">Invite New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Display Name</label>
                        <input name="Invite.DisplayName" value="@displayName" class="form-control" placeholder="John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input name="Invite.Email" type="email" value="@email" class="form-control" placeholder="guest@@example.com" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create &amp; Invite</button>
                </div>
            </form>
        </div>
    </div>
</div>
