@model (List<string> Participants, int MaxParticipants)

<h6 class="serif border-bottom pb-1 mb-3 admin-only">Participants</h6>
<div id="participant-container" data-max-participants="@Model.MaxParticipants">
    @for (var i = 0; i < Model.Participants.Count; i++)
    {
        <div class="row g-2 mb-2 participant-row">
            <div class="col">
                <input name="NewRsvp.Participants[@i]" value="@Model.Participants[i]" class="form-control participant-input" placeholder="Participant Name" required />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-danger remove-participant"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
    }
</div>
<button type="button" class="btn btn-primary btn-sm mt-2 mb-4 @(Model.Participants.Count >= Model.MaxParticipants ? "d-none" : "")" id="add-participant">
    <i class="bi bi-plus-lg me-1"></i>Add Participant
</button>
