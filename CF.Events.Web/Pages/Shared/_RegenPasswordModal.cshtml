@{
    var show = ViewData["RegenPasswordModalShow"] as bool? ?? false;
}
<div class="modal fade" id="regenPasswordModal" tabindex="-1" data-autoshow="@(show ? "true" : "false")">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="RegeneratePassword">
                <input type="hidden" name="userId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title">Regenerate Temporary Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Temporary Password</label>
                        <div class="input-group">
                            <input name="tempPassword" id="regenPassword" class="form-control"/>
                            <button class="btn btn-outline-secondary" type="button" onclick="window.fillTempPassword('regenPassword');">
                                <i class="bi bi-arrow-clockwise"></i> Generate
                            </button>
                        </div>
                        <div class="form-text mt-2">The user will be asked to change this password on their next login.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
