@using CF.Events.Web.Infrastructure.Extensions
@model string

<nav class="navbar navbar-expand-lg glass-navbar shadow-sm">
    <div class="container">
        <a class="navbar-brand fs-3" href="/">
            <img src="~/img/wedding_logo_transparent.png" alt="Logo" width="40" height="40" class="d-inline-block align-text-top">
            <span class="brand-name text-white">@Model</span>
        </a>
        <button class="navbar-toggler border-0" type="button" aria-label="Toggle navigation" id="sidebarToggle">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse flex-grow-1" id="navbarNav">
            @if (User.IsAuthenticated() && !User.InitPassword())
            {
                <ul class="navbar-nav me-auto">
                    @if (User.IsAdmin())
                    {
                        <li class="nav-item"><a class="nav-link" href="/invites">My Invites</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu glass glass-card border-0" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" href="/admin/events">Events</a></li>
                                <li><a class="dropdown-item" href="/admin/users">Users</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">@(User.GetDisplayName())</a>
                        <ul class="dropdown-menu dropdown-menu-end glass glass-card border-0" aria-labelledby="accountDropdown">
                            <li><a class="dropdown-item" href="/account/manage">Profile</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <form asp-action="Logout" asp-controller="Account" method="get">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            }
        </div>
    </div>
</nav>

<!-- Sidebar Drawer -->
<aside class="glass-sidebar" id="sidebar">
    <div class="sidebar-header d-flex justify-content-between align-items-center p-3">
        <span class="brand-name text-white fs-4">@Model</span>
        <button type="button" class="btn-close btn-close-white" id="sidebarClose" aria-label="Close"></button>
    </div>
    <div class="sidebar-content p-3">
        @if (User.IsAuthenticated() && !User.InitPassword())
        {
            <div class="sidebar-section mb-4">
                <h6 class="glass-text-muted text-uppercase small fw-bold mb-3">Navigation</h6>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item"><a class="nav-link p-0" href="/"><i class="bi bi-house me-2"></i>Home</a></li>
                    @if (User.IsAdmin())
                    {
                        <li class="nav-item"><a class="nav-link p-0" href="/invites"><i class="bi bi-envelope me-2"></i>My Invites</a></li>
                        <li class="nav-item">
                            <a class="nav-link p-0 dropdown-toggle" href="#adminSidebarSubmenu" data-bs-toggle="collapse" role="button" aria-expanded="false">
                                <i class="bi bi-shield-lock me-2"></i>Admin
                            </a>
                            <div class="collapse ps-4 mt-2" id="adminSidebarSubmenu">
                                <ul class="nav flex-column gap-2">
                                    <li><a class="dropdown-item p-0 mb-2" href="/admin/events">Events</a></li>
                                    <li><a class="dropdown-item p-0" href="/admin/users">Users</a></li>
                                </ul>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="sidebar-section">
                <h6 class="glass-text-muted text-uppercase small fw-bold mb-3">Account</h6>
                <ul class="nav flex-column gap-2">
                    <li class="nav-item"><a class="nav-link p-0" href="/account/manage"><i class="bi bi-person me-2"></i>@(User.GetDisplayName())</a></li>
                    <li class="nav-item">
                        <form asp-action="Logout" asp-controller="Account" method="get">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link p-0 text-danger border-0 bg-transparent"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</aside>
<div class="glass-sidebar-overlay" id="sidebarOverlay"></div>
