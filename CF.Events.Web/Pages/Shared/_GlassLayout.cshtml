@using CF.Events.Web.Infrastructure.Extensions
@inject IOptions<AppSettings> AppOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@(ViewData["Title"] is not null ? $"{ViewData["Title"]} - " : string.Empty)@AppOptions.Value.Title</title>
    <partial name="_Fonts"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/glass-base.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
    <partial name="_FavIcons"/>
</head>
<body class="glass-theme">
<partial name="_GlassNav" model="@AppOptions.Value.Title"/>
<main class="container-fluid">
    @RenderBody()
    <div class="loading-overlay" id="globalLoadingOverlay">
        <div class="loader"></div>
    </div>
    <partial name="_ConfirmModal"/>
</main>
<footer class="mt-auto py-4 text-center">
    <div class="container d-flex flex-column gap-2">
        @if (!User.IsAdmin())
        {
            <a href="/privacy" class="text-dark-glass text-decoration-none small opacity-75">
                <i class="bi bi-shield-check me-1"></i>Privacy & Security
            </a>
            <a href="/feedback" class="text-dark-glass small opacity-75">
                Leave Feedback
            </a>
        }
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/js/tom-select.complete.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await Component.InvokeAsync("NToastNotify")
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
