@model (int EventDuration, List<string> Participants, List<ParticipantAttendance> ParticipantsAttendance)

@for (var day = 1; day <= Model.EventDuration; day++)
{
    var attendingParticipants = Model.ParticipantsAttendance
        .Where(pa => pa.AttendingDays.Contains(day))
        .Select(pa => pa.ParticipantName)
        .ToList();
    var isChecked = attendingParticipants.Any();
    <div class="row align-items-center mb-2">
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input day-checkbox" type="checkbox" id="day-@(day)" data-day="@day"
                       @(isChecked ? "checked" : string.Empty)/>
                <label class="form-check-label" for="day-@(day)">Day @day</label>
            </div>
        </div>
        <div class="col">
            <select class="form-select tom-select participant-day-select" multiple placeholder="Who is attending?" @(isChecked ? "" : "disabled") data-day="@day">
                @foreach (var p in Model.Participants)
                {
                    <option value="@p" selected="@(attendingParticipants.Contains(p) ? "selected" : null)">@p</option>
                }
            </select>
        </div>
    </div>
}
@* Hidden inputs for ParticipantAttendance will be generated by JS *@
<div id="participant-attendance"></div>
