@page
@model CF.Events.Web.Pages.Account.EmailConfirmation

@{
    ViewData["Title"] = "Email confirmed";
}

<div class="container-fluid d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded-lg-custom shadow-sm" style="max-width: 500px; width: 100%;">
        <section class="text-center">
            <h1>Email confirmed</h1>
        </section>
        <hr/>
        <section class="card-body">
            <p>Thank you for confirming your email. You can now log in.</p>
            <a href="/Account/Login" class="btn btn-primary">Log in</a>
        </section>
    </div>
</div>
