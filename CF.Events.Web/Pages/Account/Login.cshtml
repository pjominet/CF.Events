@page
@attribute [AllowAnonymous]
@model CF.Events.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log In";
    Layout = "_GlassLayout";
}

<div class="d-flex align-items-center justify-content-center mt-5">
    <div class="card card-500 bg-glass border-glass p-4 mx-auto rounded-glass shadow-sm">
        <section class="text-center">
            <h1 class="serif">@ViewData["Title"]</h1>
        </section>
        <hr/>
        <section class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="ReturnUrl"/>
                @if (!Model.ShowPasswordStep)
                {
                    <input type="hidden" asp-for="ShowPasswordStep" value="false"/>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Continue</button>
                    </div>
                    <div class="text-center">
                        <a class="text-dark-glass" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="ShowPasswordStep" value="true"/>
                    <input type="hidden" asp-for="Input.Email"/>
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="text-dark-glass fw-semibold">@Model.Input.Email</span>
                        <a asp-page="./Login" asp-route-email="@Model.Input.Email" asp-route-returnUrl="@Model.ReturnUrl" class="text-dark-glass">Change</a>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password"/>
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            <input asp-for="Input.RememberMe" class="form-check-input"/>
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                    </div>
                    <div class="text-center">
                        <a class="text-dark-glass" asp-page="./ForgotPassword">Forgot your password?</a>
                    </div>
                }
            </form>
        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
