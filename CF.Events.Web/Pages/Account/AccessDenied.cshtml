@page "/access-denied"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Access denied";
}

<div class="container-fluid d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto rounded shadow-sm" style="max-width: 500px; width: 100%;">
        <section class="text-center">
            <h1>@ViewData["Title"]</h1>
        </section>
        <hr/>
        <section class="card-body">
            <p class="text-muted">You do not have permission to access this resource.</p>
            <a href="/" class="btn btn-primary mt-3">Back to home</a>
        </section>
    </div>
</div>
