@page "/account/reset-password-confirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="d-flex align-items-center justify-content-center mt-3">
    <div class="card card-500 border-0 p-4 mx-auto rounded shadow-sm">
        <section class="text-center">
            <h1>@ViewData["Title"]</h1>
        </section>
        <hr/>
        <section class="card-body">
            <p class="text-muted">Your password has been reset. You can now log in with your new password.</p>
            <a href="/Account/Login" class="btn btn-primary mt-3">Log in</a>
            <p class="text-muted small mb-0 mt-2">Redirecting in <span class="countdown">3</span> seconds...</p>
        </section>
    </div>
</div>

@section Scripts
{
    <script>window.autoRedirect(3);</script>
}
