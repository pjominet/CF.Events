@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Reset password confirmation";
}

<div class="container-fluid d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded-lg-custom shadow-sm" style="max-width: 500px; width: 100%;">
        <section class="text-center">
            <h1 class="cursive fs-1">Password reset</h1>
        </section>
        <hr/>
        <section class="card-body">
            <p class="text-muted">Your password has been reset. You can now log in with your new password.</p>
            <a href="/Account/Login" class="btn btn-primary mt-3">Log in</a>
        </section>
    </div>
</div>
