@page
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Registration confirmation";
}

<div class="container-fluid d-flex align-items-center justify-content-center p-3">
    <div class="card border-0 p-4 mx-auto bg-card-custom rounded-lg-custom shadow-sm" style="max-width: 500px; width: 100%;">
        <section class="text-center">
            <h1>Registration confirmation</h1>
        </section>
        <hr/>
        <section class="card-body">
            <p>Please check your email for a confirmation link to complete your registration.</p>
            <a href="/Account/Login" class="btn btn-primary">Back to login</a>
        </section>
    </div>
</div>
