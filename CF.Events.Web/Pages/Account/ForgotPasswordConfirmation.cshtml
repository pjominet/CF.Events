@page "/account/forgot-password-confirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="d-flex align-items-center justify-content-center mt-5">
    <div class="card card-500 border-0 p-4 mx-auto rounded shadow-sm">
        <section class="text-center">
            <h1>Forgot password confirmation</h1>
        </section>
        <hr/>
        <section class="card-body">
            @if (TempData["ResetPasswordLink"] is string resetLink)
            {
                <div class="alert alert-info mt-3">
                    <p><strong>Development test mode:</strong></p>
                    <div class="input-group mt-2">
                        <input type="text" class="form-control" value="@resetLink" id="resetLinkInput" readonly>
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="copyToClipboardAndShowFeedback('resetLinkInput', this)">
                            Copy
                        </button>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">If an account with that email exists, password reset instructions have been provided.</p>
            }
            <a href="/Account/Login" class="btn btn-primary mt-3">Back to login</a>
        </section>
    </div>
</div>
